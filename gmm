__version__ = '3.1.0'
DEFAULT_CONFIG = '''# GMM 3: works with existing mounts; never requests mounting.
version = 3
[general]
mount_structure_dir = "~/Devices"
notifications = true
[storage]
# Optional paths relative to the phone mount, e.g. ["/storage/custom:Work"]
custom_paths = []
[logging]
level = "INFO"
'''


def config_home():
    return Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')


def state_home():
    return Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'gmm'


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.gmm-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default


def backup(path):
    """Rename the item itself, never traverse a conflicting symlink or directory."""
    stamp = time.strftime('%Y%m%d-%H%M%S')
    candidate = path.with_name(f'{path.name}.gmm-backup-{stamp}')
    number = 1
    while os.path.lexists(candidate):
        candidate = path.with_name(f'{path.name}.gmm-backup-{stamp}-{number}')
        number += 1
    path.rename(candidate)
    logging.warning('Preserved existing item at %s', candidate)
    return candidate


@dataclass
class Config:
    path: Path = field(default_factory=lambda: config_home() / 'gmm/config.toml')
    directory: Path = field(default_factory=lambda: Path.home() / 'Devices')
    notifications: bool = True
    custom_paths: list[str] = field(default_factory=list)
    level: str = 'INFO'

    @classmethod
    def load(cls):
        cfg = cls()
        if not cfg.path.exists():
            return cfg
        data = tomllib.loads(cfg.path.read_text())
        if data.get('version') != 3:
            raise ValueError('Old configuration: rerun install.sh to migrate to GMM 3.')
        general = data.get('general', {})
        directory = general.get('mount_structure_dir', '~/Devices')
        if not isinstance(directory, str):
            raise ValueError('mount_structure_dir must be a path string')
        cfg.directory = Path(os.path.expandvars(directory)).expanduser().absolute()
        if cfg.directory in (Path('/'), Path.home()):
            raise ValueError('Use a dedicated folder for terminal links, such as ~/Devices')
        cfg.notifications = general.get('notifications', True)
        if not isinstance(cfg.notifications, bool):
            raise ValueError('notifications must be true or false')
        cfg.custom_paths = data.get('storage', {}).get('custom_paths', [])
        if not isinstance(cfg.custom_paths, list) or not all(isinstance(p, str) for p in cfg.custom_paths):
            raise ValueError('custom_paths must be a list of path:label strings')
        for value in cfg.custom_paths:
            path, separator, label = value.rpartition(':')
            if not separator or not label.strip() or '..' in PurePosixPath(path).parts:
                raise ValueError(f'Invalid custom storage path: {value!r}')
        cfg.level = data.get('logging', {}).get('level', 'INFO')
        if not isinstance(cfg.level, str):
            raise ValueError('logging.level must be a string')
        cfg.level = cfg.level.upper()
        if cfg.level not in ('DEBUG', 'INFO', 'WARNING', 'ERROR'):
            raise ValueError('Invalid logging level')
        return cfg


def clean_legacy(directory):
    """Remove v2 links only where the manifest and current target agree."""
    if not directory.is_dir() or directory.is_symlink():
        return
    for folder in directory.iterdir():
        manifest = folder / '.gmm-links.json'
        if folder.is_symlink() or not folder.is_dir() or manifest.is_symlink():
            continue
        links = read_json(manifest, {})
        if not isinstance(links, dict):
            raise ValueError(f'Invalid legacy manifest: {manifest}')
        for name, target in links.items():
            if not isinstance(name, str) or Path(name).name != name or name in ('.', '..'):
                continue
            link = folder / name
            if isinstance(target, str) and link.is_symlink() and os.readlink(link) == target:
                link.unlink()
        if manifest.exists():
            manifest.unlink()
        with contextlib.suppress(OSError):
            folder.rmdir()


def prepare_config():
    path = config_home() / 'gmm/config.toml'
    old = {}
    if path.exists():
        # A corrupt legacy config is backed up too; do not guess its old folders.
        try:
            old = tomllib.loads(path.read_text())
        except tomllib.TOMLDecodeError:
            pass
        if old.get('version') == 3:
            Config.load()  # Validate before the installer starts the service.
            return
        # Keep the original in place until migration succeeds, so a retry can
        # still find its custom folder after a failed cleanup.
        saved = path.with_name(f'{path.name}.gmm-backup-{time.time_ns()}')
        shutil.copy2(path, saved)
        print(f'GMM 3 applies new defaults. Previous settings: {saved}')
        print('Reapply supported custom paths and notification settings in config.toml.')
    legacy = config_home() / 'gmm/gmm.conf'
    if legacy.exists():
        print(f'Legacy shell config preserved at {backup(legacy)}; reapply supported settings.')
    directory = Path(os.path.expandvars(old.get('general', {}).get('mount_structure_dir', '~/Devices'))).expanduser()
    clean_legacy(directory)
    # Legacy bookmark ownership is consumed on the next reconciliation.
    atomic_write(path, DEFAULT_CONFIG)


def safe_name(name):
    return re.sub(r'[^\w.-]+', '_', name).strip('._-')[:100] or 'Phone'


def display_name(name):
    return ' '.join(name.split()) or 'Phone'


def suffix(identity):
    return hashlib.sha256(identity.encode()).hexdigest()[:8]


@dataclass
class Mount:
    device_id: str
    name: str
    local: Path | None
    uri: str
    paths: dict[str, str] = field(default_factory=dict)


def _dbus_read(bus, service, path, interface, method, parameters=None):
    try:
        reply = bus.call_sync(service, path, interface, method, parameters, None,
                              Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
        return reply.unpack()[0]
    except Exception as error:
        raise RuntimeError(f"Cannot read {service} {method}: {error}") from error


def _gsconnect_host(device_id):
    """Read the connected phone's last LAN address without changing settings."""
    if not re.fullmatch(r"[A-Za-z0-9_-]+", device_id):
        return None
    schema_name = "org.gnome.Shell.Extensions.GSConnect.Device"
    try:
        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup(schema_name, True) if source else None
        if schema is None:
            directories = [os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))]
            directories += os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
            for directory in directories:
                path = Path(directory) / "gnome-shell/extensions/gsconnect@andyholmes.github.io/schemas"
                if (path / "gschemas.compiled").is_file():
                    extension_source = Gio.SettingsSchemaSource.new_from_directory(str(path), source, False)
                    schema = extension_source.lookup(schema_name, True)
                    if schema:
                        break
        if schema is None or not schema.has_key("last-connection"):
            return None
        settings = Gio.Settings.new_full(schema, None,
            f"/org/gnome/shell/extensions/gsconnect/device/{device_id}/")
        address = urllib.parse.urlsplit(settings.get_string("last-connection"))
        return address.hostname if address.scheme == "lan" else None
    except Exception:
        return None


def _sshfs_mount_points():
    """Verify KDE's reported mount actually exists, without accessing its root."""
    points = set()
    try:
        for line in Path("/proc/self/mountinfo").read_text().splitlines():
            before, after = line.split(" - ", 1)
            if after.split()[0] not in ("fuse.sshfs", "fuse3.sshfs"):
                continue
            escaped = before.split()[4]
            points.add(re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), escaped))
    except (OSError, ValueError, IndexError) as error:
        raise RuntimeError(f"Cannot verify existing SSHFS mounts: {error}") from error
    return points


def _kde_storage_paths(directories, mountpoint):
    """KDE returns local path -> advertised label, not label -> remote path."""
    paths = {}
    for full_path, reported_name in sorted(directories.items()):
        path = Path(full_path)
        if not path.is_absolute() or ".." in path.parts:
            continue
        try:
            relative = path.relative_to(mountpoint).as_posix()
        except ValueError:
            continue
        label = str(reported_name).strip() or "Storage"
        if relative == "storage/emulated/0":
            label = "Internal"
        original = label
        suffix = 2
        while label in paths:
            label = f"{original} {suffix}"
            suffix += 1
        paths[label] = relative
    return paths


def discover_mounts() -> tuple[list[Mount], list[str]]:
    """Snapshot existing paired-device mounts; failures invalidate the snapshot."""
    if Gio is None or GLib is None:
        raise RuntimeError("PyGObject with Gio is required to inspect phone connections.")
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    except Exception as error:
        raise RuntimeError(f"Cannot connect to the desktop session bus: {error}") from error
    services = _dbus_read(bus, "org.freedesktop.DBus", "/org/freedesktop/DBus",
                          "org.freedesktop.DBus", "ListNames")
    mounts, notes = [], []
    gsconnect = "org.gnome.Shell.Extensions.GSConnect"
    kdeconnect = "org.kde.kdeconnect"
    if gsconnect in services:
        interface = "org.gnome.Shell.Extensions.GSConnect.Device"
        objects = _dbus_read(bus, gsconnect, "/org/gnome/Shell/Extensions/GSConnect",
                             "org.freedesktop.DBus.ObjectManager", "GetManagedObjects")
        phones = []
        for path, interfaces in objects.items():
            props = interfaces.get(interface, {})
            if not props.get("Paired"):
                continue
            device_id = str(props.get("Id") or path.rsplit("/", 1)[-1])
            name = str(props.get("Name") or "Phone")
            if not props.get("Connected"):
                notes.append(f"{name}: paired in GSConnect, offline.")
                continue
            host = props.get("TcpHost") or _gsconnect_host(device_id)
            if not host:
                notes.append(f"{name}: connected in GSConnect, LAN address unavailable; cannot match storage.")
                continue
            phones.append((device_id, name, str(host).casefold()))
        matched = set()
        for mounted in Gio.VolumeMonitor.get().get_mounts():
            root = mounted.get_root()
            if root is None or root.get_uri_scheme() != "sftp":
                continue
            uri = root.get_uri()
            try:
                endpoint = urllib.parse.urlsplit(uri)
                port = endpoint.port
            except ValueError:
                continue
            # GSConnect's SFTP plugin uses ports 1739–1764. Do not adopt port 22.
            if not endpoint.hostname or port is None or not 1739 <= port <= 1764:
                continue
            owners = [phone for phone in phones if phone[2] == endpoint.hostname.casefold()]
            if len(owners) != 1:
                notes.append("An SFTP mount did not match exactly one connected GSConnect phone; ignored.")
                continue
            device_id, name, _ = owners[0]
            local = root.get_path()
            exposed = urllib.parse.unquote(endpoint.path).rstrip('/')
            paths = {}
            if exposed.endswith('/storage/emulated/0'):
                paths = {'Internal': ''}
            elif re.fullmatch(r'/storage/[0-9a-fA-F]{4}-[0-9a-fA-F]{4}', exposed):
                paths = {'SD card': ''}
            mounts.append(Mount("gsconnect:" + device_id, name,
                                Path(local) if local else None, uri, paths))
            matched.add(device_id)
        for device_id, name, _ in phones:
            if device_id not in matched:
                notes.append(f"{name}: connected in GSConnect, no matching SFTP mount; use GSConnect to mount it.")
    if kdeconnect in services:
        ids = _dbus_read(bus, kdeconnect, "/modules/kdeconnect",
                        "org.kde.kdeconnect.daemon", "devices", GLib.Variant("(bb)", (True, True)))
        active = _sshfs_mount_points()
        for device_id in ids:
            if not re.fullmatch(r"[A-Za-z0-9_-]+", device_id):
                continue
            path = "/modules/kdeconnect/devices/" + device_id
            props = _dbus_read(bus, kdeconnect, path, "org.freedesktop.DBus.Properties",
                              "GetAll", GLib.Variant("(s)", ("org.kde.kdeconnect.device",)))
            if not props.get("isPaired") or not props.get("isReachable"):
                continue
            name = str(props.get("name") or "Phone")
            sftp = "org.kde.kdeconnect.device.sftp"
            try:
                is_mounted = _dbus_read(bus, kdeconnect, path + "/sftp", sftp, "isMounted")
            except RuntimeError as error:
                if any(code in str(error) for code in ('UnknownObject', 'UnknownInterface', 'UnknownMethod')):
                    notes.append(f'{name}: KDE Connect SFTP plugin unavailable.')
                    continue
                raise
            if not is_mounted:
                notes.append(f"{name}: connected in KDE Connect, storage not mounted; use Browse device.")
                continue
            point = _dbus_read(bus, kdeconnect, path + "/sftp", sftp, "mountPoint")
            if point not in active or not Path(point).is_absolute():
                notes.append(f"{name}: KDE Connect reports a mount but its SSHFS mount is not ready.")
                continue
            directories = _dbus_read(bus, kdeconnect, path + "/sftp", sftp, "getDirectories")
            mountpoint = Path(point)
            mounts.append(Mount("kdeconnect:" + device_id, name, mountpoint,
                                mountpoint.as_uri(), _kde_storage_paths(directories, mountpoint)))
    if gsconnect not in services and kdeconnect not in services:
        notes.append("Neither GSConnect nor KDE Connect is running in this desktop session.")
    return mounts, notes



def child_uri(uri, relative):
    if '..' in PurePosixPath(relative).parts:
        raise ValueError('Storage path escapes mount')
    relative = str(PurePosixPath(relative)).strip('/')
    if relative == '.':
        relative = ''
    return uri.rstrip('/') + ('/' + urllib.parse.quote(relative.strip('/'), safe='/') if relative.strip('/') else '/')


class Reader:
    """No mount APIs: a missing mount produces an error, never an implicit mount request."""
    def directories(self, uri):
        file = Gio.File.new_for_uri(uri)
        enumerator = file.enumerate_children('standard::name,standard::type', Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, None)
        result = []
        try:
            # Only shallow metadata. Never recursively scan phone files.
            for _ in range(256):
                info = enumerator.next_file(None)
                if info is None:
                    break
                if info.get_file_type() == Gio.FileType.DIRECTORY:
                    result.append(info.get_name())
        finally:
            enumerator.close(None)
        return result

    def readable(self, uri):
        enumerator = Gio.File.new_for_uri(uri).enumerate_children('standard::name', Gio.FileQueryInfoFlags.NONE, None)
        enumerator.close(None)  # Empty storage is valid too.
        return True


def probe_failure(error):
    """Missing/denied candidates are normal; transport failures invalidate the scan."""
    if isinstance(error, (PermissionError, FileNotFoundError, NotADirectoryError)):
        return
    if GLib is not None and isinstance(error, GLib.Error):
        if any(error.matches(Gio.io_error_quark(), code) for code in
               (Gio.IOErrorEnum.PERMISSION_DENIED, Gio.IOErrorEnum.NOT_FOUND,
                Gio.IOErrorEnum.NOT_DIRECTORY)):
            return
    raise RuntimeError(f'Storage read failed: {error}') from error


def storage_paths(mount, config, reader):
    """Probe the known child before listing root: root enumeration may be denied."""
    candidates = dict(mount.paths)
    if 'storage/emulated/0' not in candidates.values():
        label = 'Internal' if 'Internal' not in candidates else 'Internal storage'
        candidates[label] = 'storage/emulated/0'
    for custom in config.custom_paths:
        path, _, label = custom.rpartition(':')
        candidates[label.strip()] = path.strip('/')
    try:
        volumes = reader.directories(child_uri(mount.uri, 'storage'))
        for name in sorted(volumes):
            if re.fullmatch(r'[0-9a-fA-F]{4}-[0-9a-fA-F]{4}', name):
                label = 'SD card' if 'SD card' not in candidates else f'SD card {name}'
                candidates[label] = f'storage/{name}'
    except Exception as error:
        probe_failure(error)
    result, seen = {}, set()
    for label, relative in candidates.items():
        relative = str(PurePosixPath(relative.strip('/')))
        if relative == '.':
            relative = ''
        if relative in seen or '..' in PurePosixPath(relative).parts:
            continue
        try:
            if reader.readable(child_uri(mount.uri, relative)):
                result[display_name(label)] = relative
                seen.add(relative)
        except Exception as error:
            probe_failure(error)
    if not result:
        try:
            root_names = reader.directories(mount.uri)
            if set(root_names) & {'DCIM', 'Download', 'Documents', 'Pictures', 'Music'}:
                result['Internal'] = ''
        except Exception as error:
            probe_failure(error)
    return result


def scan(config, mounts=None, reader=None):
    if mounts is None:
        mounts, notes = discover_mounts()
    else:
        notes = []
    reader = reader or Reader()
    entries, devices, groups = [], {}, {}
    for mount in mounts:
        group = groups.setdefault(mount.device_id, {'name': display_name(mount.name), 'paths': {}})
        for label, relative in storage_paths(mount, config, reader).items():
            uri = child_uri(mount.uri, relative).rstrip('/')
            group['paths'].setdefault(uri, (label, str(mount.local / relative) if mount.local else None))
    for identity, group in groups.items():
        friendly = group['name']
        if sum(g['name'].casefold() == friendly.casefold() for g in groups.values()) > 1:
            friendly += f' ({suffix(identity)})'
        # KDE can advertise Camera as well as its containing storage. Expose
        # only accessible top-level locations, including across GVfs mounts.
        partitions = {uri: item for uri, item in group['paths'].items()
                      if not any(uri.startswith(parent + '/') for parent in group['paths'] if parent != uri)}
        devices[identity] = {'name': friendly, 'ready': bool(partitions)}
        if not partitions:
            notes.append(f'{friendly}: mount exists, but no usable storage found; check Android storage permissions or custom_paths.')
        labels = [item[0] for item in partitions.values()]
        for uri, (label, target) in partitions.items():
            if labels.count(label) > 1:
                label += f' ({suffix(uri)})'
            title = friendly if len(partitions) == 1 else f'{friendly} / {label}'
            link_name = safe_name(friendly) if len(partitions) == 1 else f'{safe_name(friendly)}_{safe_name(label)}'
            entries.append({'id': identity + ':' + uri, 'label': title,
                            'uri': uri if urllib.parse.urlsplit(uri).path else uri + '/', 'name': link_name, 'target': target})
            if target is None:
                notes.append(f'{friendly}: remote entry available; no local mount path for terminal links (check GVfs FUSE).')
    # Filesystem-safe names can collide even when display names differ.
    names = [e['name'].casefold() for e in entries]
    for entry in entries:
        if names.count(entry['name'].casefold()) > 1:
            entry['name'] += '_' + suffix(entry['id'])
    return {'entries': entries, 'devices': devices, 'notes': notes}


class Artifacts:
    """Own exact bookmark lines and link targets, including across restarts."""
    def __init__(self, directory=None, bookmarks=None):
        self.directory = directory or state_home()
        self.path = self.directory / 'owned.json'
        self.bookmarks = bookmarks or config_home() / 'gtk-3.0/bookmarks'

    def load(self):
        state = read_json(self.path, {'links': {}, 'bookmarks': []})
        if not isinstance(state, dict) or not isinstance(state.get('links'), dict) or not isinstance(state.get('bookmarks'), list):
            raise ValueError('Invalid GMM ownership state; refusing cleanup')
        if not all(isinstance(k, str) and isinstance(v, str) for k, v in state['links'].items()) or not all(isinstance(v, str) for v in state['bookmarks']):
            raise ValueError('Invalid GMM ownership records')
        return state

    def save(self, state):
        atomic_write(self.path, json.dumps(state, indent=2))

    def reconcile(self, config, entries):
        self.directory.mkdir(parents=True, exist_ok=True)
        with open(self.directory / 'artifacts.lock', 'a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            state = self.load()
            desired = {str(config.directory / e['name']): e['target'] for e in entries if e['target']}
            for path, target in list(state['links'].items()):
                link = Path(path)
                if desired.get(path) != target:
                    if link.is_symlink() and os.readlink(link) == target:
                        link.unlink()
                    del state['links'][path]
            self.save(state)
            for path, target in desired.items():
                link = Path(path)
                link.parent.mkdir(parents=True, exist_ok=True)
                if link.is_symlink() and os.readlink(link) == target and state['links'].get(path) == target:
                    continue
                if os.path.lexists(link):
                    backup(link)
                # Persist intent first so interruption after link creation remains recoverable.
                state['links'][path] = target
                self.save(state)
                link.symlink_to(target, target_is_directory=True)
            self.update_bookmarks(state, [f"{e['uri']} {e['label']}" for e in entries])

    def update_bookmarks(self, state, desired):
        self.bookmarks.parent.mkdir(parents=True, exist_ok=True)
        # Same lock as GMM 2. Editors outside GMM may still race with replacement.
        with open(self.bookmarks.with_suffix('.lock'), 'a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                lines = self.bookmarks.read_text().splitlines()
            except FileNotFoundError:
                lines = []
            legacy_path = self.bookmarks.with_name('gmm-bookmarks.json')
            legacy = read_json(legacy_path, {})
            if not isinstance(legacy, dict) or not all(isinstance(v, list) and all(isinstance(x, str) for x in v) for v in legacy.values()):
                raise ValueError('Invalid legacy bookmark ownership; refusing cleanup')
            old = set(state['bookmarks']) | {line for group in legacy.values() for line in group}
            kept = [line for line in lines if line not in old]
            additions = list(dict.fromkeys(line for line in desired if line not in kept))
            # Journal the old and new exact lines until replacement completes.
            state['bookmarks'] = list(old | set(additions))
            self.save(state)
            updated = kept + additions
            if updated != lines:
                atomic_write(self.bookmarks, ''.join(line + '\n' for line in updated))
            state['bookmarks'] = additions
            self.save(state)
            if legacy_path.exists():
                legacy_path.unlink()


def notify(message):
    if not Gio:
        return
    try:
        connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        connection.call_sync('org.freedesktop.Notifications', '/org/freedesktop/Notifications',
                             'org.freedesktop.Notifications', 'Notify',
                             GLib.Variant('(susssasa{sv}i)', ('GMM', 0, 'phone', 'Phone storage', message, [], {}, 5000)),
                             None, Gio.DBusCallFlags.NO_AUTO_START, 1500, None)
    except Exception as exc:
        logging.debug('Notification unavailable: %s', exc)


def collect_snapshot():
    """Isolate potentially stuck remote filesystem operations from cleanup/control."""
    result = subprocess.run([sys.executable, str(Path(__file__).absolute()), '--scan'],
                            capture_output=True, text=True, timeout=15)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'Storage scan failed')
    return json.loads(result.stdout)


def daemon(config):
    directory = state_home()
    directory.mkdir(parents=True, exist_ok=True)
    with open(directory / 'daemon.lock', 'a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('GMM daemon is already running')
        lock.seek(0)
        lock.truncate()
        lock.write(str(os.getpid()))
        lock.flush()
        stopping = False
        def stop(*_):
            nonlocal stopping
            stopping = True
        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        artifacts, previous, previous_notes = Artifacts(), {}, None
        while not stopping:
            try:
                snapshot = collect_snapshot()
                artifacts.reconcile(config, snapshot['entries'])
                snapshot['checked_at'] = time.time()
                atomic_write(directory / 'status.json', json.dumps(snapshot, indent=2))
                if snapshot['notes'] != previous_notes:
                    for note in snapshot['notes']:
                        logging.info(note)
                    previous_notes = snapshot['notes']
                current = snapshot['devices']
                if config.notifications:
                    for identity, device in current.items():
                        if previous.get(identity) != device:
                            notify(f"{device['name']}: " + ('storage is ready.' if device['ready'] else 'no accessible storage found. Run gmm doctor for details.'))
                    for identity, device in previous.items():
                        if identity not in current:
                            notify(f"{device['name']}: storage disconnected.")
                previous = current
            except Exception as exc:
                message = f'Storage scan failed; keeping previous entries: {exc}'
                if message != previous_notes:
                    logging.warning(message)
                    previous_notes = message
                atomic_write(directory / 'scan-error.txt', message)
            else:
                (directory / 'scan-error.txt').unlink(missing_ok=True)
            for _ in range(20):  # Ten seconds; promptly interruptible on shutdown.
                if stopping:
                    break
                time.sleep(0.5)


def daemon_running():
    path = state_home() / 'daemon.lock'
    if not path.exists():
        return False
    with open(path, 'a+') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
    return False


def report(config, detailed=False, config_error=None):
    print(f'GMM {__version__}')
    running = daemon_running()
    print('Daemon: ' + ('running' if running else 'not running'))
    failures = not running or bool(config_error)
    artifacts = Artifacts()
    try:
        state = artifacts.load()
        lines = artifacts.bookmarks.read_text().splitlines() if artifacts.bookmarks.exists() else []
        snapshot = {'entries': [], 'notes': []}
        if config_error:
            print(f'Configuration error: {config_error}')
            print('Live discovery skipped until the configuration is corrected.')
        else:
            snapshot = collect_snapshot()
        expected_links = dict(state['links'])
        expected_bookmarks = set(state['bookmarks'])
        for entry in snapshot['entries']:
            print(f"{entry['label']}: {entry['uri']}")
            if entry['target']:
                expected_links[str(config.directory / entry['name'])] = entry['target']
            expected_bookmarks.add(f"{entry['uri']} {entry['label']}")
        for path, target in expected_links.items():
            link = Path(path)
            valid = link.is_symlink() and os.readlink(link) == target
            print(f"Terminal link: {path}: {'present' if valid else 'missing or changed'}")
            failures |= not valid
        missing = expected_bookmarks - set(lines)
        print(f'Bookmarks: {len(expected_bookmarks) - len(missing)}/{len(expected_bookmarks)} expected entries present')
        failures |= bool(missing)
        for line in sorted(missing):
            print(f'Missing bookmark: {line}')
        for note in snapshot['notes']:
            print(note)
        if not snapshot['entries'] and not config_error:
            print('No usable phone storage detected. Check the notes above and the native mount in GSConnect/KDE Connect.')
    except Exception as exc:
        print(f'Diagnostics failed: {exc}')
        failures = True
    if detailed:
        print(f'Config: {config.path}\nTerminal links: {config.directory}\nGTK bookmarks: {artifacts.bookmarks}')
        try:
            installed = read_json(state_home() / 'status.json', {})
            stamp = installed.get('checked_at')
            print('Last daemon scan: ' + (time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(stamp)) if stamp else 'none recorded'))
            error = state_home() / 'scan-error.txt'
            if error.exists():
                print(error.read_text())
        except (OSError, ValueError, TypeError, AttributeError) as exc:
            print(f'Saved daemon status unavailable: {exc}')
            failures = True
        print('Automatic sidebar entries target GTK file managers; Dolphin Places is not supported.')
    return int(failures)


def update():
    current_version = __version__
    url = 'https://raw.githubusercontent.com/vjaykrsna/gsconnect-mount-manager/main/install.sh'
    with urllib.request.urlopen(url, timeout=30) as response:
        data = response.read(1024 * 1024 + 1)
    if len(data) > 1024 * 1024 or not data.startswith(b'#!/'):
        raise ValueError('Unexpected installer response')
    # Extract new version from installer header
    new_version = 'unknown'
    for line in data.decode().splitlines():
        if line.startswith('# GMM '):
            new_version = line.split('# GMM ')[1].split(' ')[0]
            break
    if new_version == current_version:
        print(f'Already at latest version {current_version}')
        return 0
    with tempfile.TemporaryDirectory(prefix='gmm-update-') as folder:
        installer = Path(folder) / 'install.sh'
        installer.write_bytes(data)
        rc = subprocess.run(['bash', str(installer)], capture_output=True, text=True).returncode
    if rc == 0:
        print(f'Updated GMM {current_version} → {new_version}')
    return rc


@contextlib.contextmanager
def stopped_daemon():
    """Stop a service or manual daemon, then hold its lock during cleanup."""
    systemctl = shutil.which('systemctl')
    if systemctl:
        subprocess.run([systemctl, '--user', 'stop', 'gmm.service'], capture_output=True)
    state_home().mkdir(parents=True, exist_ok=True)
    with open(state_home() / 'daemon.lock', 'a+') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock.seek(0)
            pid = lock.read().strip()
            if not pid.isdigit() or int(pid) <= 1 or int(pid) == os.getpid():
                raise RuntimeError('Stop the manually started GMM daemon before uninstalling.')
            with contextlib.suppress(ProcessLookupError):
                os.kill(int(pid), signal.SIGTERM)
            deadline = time.monotonic() + 20
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise RuntimeError('GMM did not stop; uninstall aborted. Stop the daemon and retry.')
                    time.sleep(0.1)
        yield systemctl


def uninstall(config, yes=False, purge=False):
    if not yes and input('Remove GMM and its links and bookmarks? [y/N] ').lower() not in ('y', 'yes'):
        return 0
    with stopped_daemon() as systemctl:
        Artifacts().reconcile(config, [])
        if systemctl:
            subprocess.run([systemctl, '--user', 'disable', 'gmm.service'], capture_output=True)
        (config_home() / 'systemd/user/gmm.service').unlink(missing_ok=True)
        if systemctl:
            subprocess.run([systemctl, '--user', 'daemon-reload'], capture_output=True)
        binary = Path(os.environ.get('XDG_BIN_HOME') or Path.home() / '.local/bin') / 'gmm'
        binary.unlink(missing_ok=True)
        if purge:
            config.path.unlink(missing_ok=True)
    print('GMM removed. Native phone mounts and saved backups are preserved.')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--version', action='version', version=f'gmm {__version__}')
    parser.add_argument('--prepare-config', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('--scan', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('command', nargs='?', choices=('daemon', 'status', 'doctor', 'update', 'uninstall'), default='status')
    parser.add_argument('--yes', action='store_true', help='confirm uninstall')
    parser.add_argument('--purge', action='store_true', help='also remove active configuration on uninstall; keep backups')
    args = parser.parse_args()
    try:
        if args.prepare_config:
            prepare_config()
            return 0
        if args.command == 'update' and not args.scan:
            return update()
        config_error = None
        try:
            config = Config.load()
        except (OSError, ValueError, TypeError, AttributeError) as exc:
            if args.scan or args.command not in ('uninstall', 'status', 'doctor'):
                raise
            config, config_error = Config(), str(exc)
        logging.basicConfig(level=config.level, format='%(levelname)s: %(message)s')
        if args.scan:
            if Gio is None:
                raise RuntimeError('PyGObject/GIO is required; install your distribution’s Python GObject bindings')
            print(json.dumps(scan(config)))
        elif args.command == 'daemon':
            daemon(config)
        elif args.command in ('status', 'doctor'):
            return report(config, args.command == 'doctor', config_error)
        elif args.command == 'uninstall':
            return uninstall(config, args.yes, args.purge)
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as exc:
        print(f'gmm: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
