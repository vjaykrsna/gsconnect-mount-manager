class CLI:
    """Command Line Interface for GMM management."""

    def __init__(self, config: Config) -> None:
        self.config = config
        self.dbus = DBusHelper()
        self.bookmarks = BookmarkManager(config.bookmark_file)

    def cmd_status(self) -> int:
        """Display current GMM status, mounts, and bookmarks."""
        print(colorize(f"GMM (GSConnect Mount Manager) v{__version__}", COLOR_BOLD))
        print("─" * 50)
        print(f"Base Directory : {self.config.mount_structure_dir}")
        print(f"Bookmark Mode  : {self.config.bookmark_mode}")
        print(f"Bookmarks File : {self.config.bookmark_file}")
        print(f"Config File    : {self.config.config_path}")

        # Check running daemon via systemctl
        daemon_active = False
        try:
            res = subprocess.run(
                ["systemctl", "--user", "is-active", "--quiet", "gmm.service"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            daemon_active = (res.returncode == 0)
        except Exception:
            pass

        status_str = colorize("● Active (running)", COLOR_GREEN) if daemon_active else colorize("○ Inactive (stopped)", COLOR_YELLOW)
        print(f"Daemon Service : {status_str}")
        print()

        # Active mounts in GVfs
        print(colorize("Active SFTP Mounts:", COLOR_BOLD))
        sftp_mounts_found = False
        if HAS_GI and Gio:
            vm = Gio.VolumeMonitor.get()
            for m in vm.get_mounts():
                root = m.get_root()
                if root and root.get_uri_scheme() == "sftp":
                    loc = m.get_default_location()
                    path = loc.get_path() if loc else "N/A"
                    print(f"  • {colorize(m.get_name(), COLOR_CYAN)}")
                    print(f"    URI  : {root.get_uri()}")
                    print(f"    Path : {path}")
                    sftp_mounts_found = True

        if not sftp_mounts_found:
            print("  (No active SFTP storage mounts detected)")
        print()

        # Existing device directories
        print(colorize("Managed Device Folders:", COLOR_BOLD))
        dirs_found = False
        if self.config.mount_structure_dir.exists():
            for item in sorted(self.config.mount_structure_dir.iterdir()):
                if item.is_dir():
                    links = [l.name for l in item.iterdir() if l.is_symlink()]
                    links_str = ", ".join(links) if links else "no symlinks"
                    print(f"  • {item.name}/ [{links_str}]")
                    dirs_found = True

        if not dirs_found:
            print(f"  (No device folders in {self.config.mount_structure_dir})")
        print()

        # Registered bookmarks
        print(colorize("Current GTK Bookmarks:", COLOR_BOLD))
        all_bm = self.bookmarks.get_bookmarks()
        gmm_bm = [b for b in all_bm if "Devices" in b or "sftp://" in b]
        if gmm_bm:
            for b in gmm_bm:
                print(f"  • {b}")
        else:
            print("  (No device bookmarks registered)")

        return 0

    def cmd_list(self) -> int:
        """List paired devices from GSConnect and KDE Connect."""
        print(colorize("Available Paired Devices:", COLOR_BOLD))
        print("─" * 50)
        backends = self.dbus.detect_backends()
        if not backends:
            print("No active GSConnect or KDE Connect D-Bus services found.")
            return 0

        devices = self.dbus.get_all_devices()
        if not devices:
            print("No paired devices found.")
            return 0

        for dev in devices:
            reach_str = colorize("Online", COLOR_GREEN) if dev.is_reachable else colorize("Offline", COLOR_YELLOW)
            mount_str = colorize("Mounted", COLOR_CYAN) if dev.is_mounted else "Unmounted"
            print(f"• {colorize(dev.name, COLOR_BOLD)} ({dev.backend})")
            print(f"  ID     : {dev.id}")
            print(f"  Status : {reach_str} | {mount_str}")

        return 0

    def cmd_mount(self, device_query: str) -> int:
        """Trigger mount for a specific device."""
        dev = self.dbus.find_device_by_name_or_id(device_query)
        if not dev:
            print(colorize(f"Error: Device '{device_query}' not found.", COLOR_RED))
            return 1

        print(f"Mounting {dev.name} ({dev.backend})...")
        if dev.backend == "kdeconnect":
            success = self.dbus.mount_kde_device(dev.id)
        elif dev.backend == "gsconnect":
            success = self.dbus.mount_gsconnect_device(dev.id)
        else:
            success = False

        if success:
            print(colorize(f"Successfully triggered mount for {dev.name}.", COLOR_GREEN))
            return 0
        else:
            print(colorize(f"Failed to mount {dev.name}.", COLOR_RED))
            return 1

    def cmd_unmount(self, device_query: str) -> int:
        """Unmount a specific device and clean up."""
        dev = self.dbus.find_device_by_name_or_id(device_query)
        if not dev:
            print(colorize(f"Error: Device '{device_query}' not found.", COLOR_RED))
            return 1

        print(f"Unmounting {dev.name} ({dev.backend})...")
        if dev.backend == "kdeconnect":
            self.dbus.unmount_kde_device(dev.id)

        # Trigger cleanup
        sanitized = sanitize_device_name(dev.name)
        self.bookmarks.remove_device_bookmarks(sanitized)
        dev_dir = self.config.mount_structure_dir / sanitized
        if dev_dir.exists():
            shutil.rmtree(dev_dir, ignore_errors=True)
            print(f"Removed local directory {dev_dir}")

        print(colorize(f"Cleaned up {dev.name}.", COLOR_GREEN))
        return 0

    def cmd_clean(self) -> int:
        """Clean up stale symlinks, empty device folders, and dangling bookmarks."""
        print(colorize("Cleaning up GMM artifacts...", COLOR_BOLD))
        removed_links = 0
        removed_dirs = 0

        # Clean dead symlinks and empty directories
        if self.config.mount_structure_dir.exists():
            for dev_dir in list(self.config.mount_structure_dir.iterdir()):
                if dev_dir.is_dir():
                    for link in list(dev_dir.iterdir()):
                        if link.is_symlink():
                            # Check if symlink target is missing or broken
                            try:
                                if not link.resolve().exists():
                                    link.unlink()
                                    removed_links += 1
                                    logging.info(f"Removed broken symlink: {link}")
                            except Exception:
                                link.unlink()
                                removed_links += 1

                    # Remove directory if empty
                    try:
                        if not any(dev_dir.iterdir()):
                            dev_dir.rmdir()
                            removed_dirs += 1
                            logging.info(f"Removed empty directory: {dev_dir}")
                    except OSError:
                        pass

        # Clean bookmarks
        bookmarks = self.bookmarks.get_bookmarks()
        cleaned_bookmarks = []
        for b in bookmarks:
            parts = b.split(" ", 1)
            uri = parts[0]
            if uri.startswith("file://"):
                path_str = uri.replace("file://", "")
                if self.config.mount_structure_dir.as_posix() in path_str:
                    if not Path(path_str).exists():
                        continue
            cleaned_bookmarks.append(b)

        if len(cleaned_bookmarks) != len(bookmarks):
            try:
                temp_p = self.config.bookmark_file.with_suffix(".tmp")
                with open(temp_p, "w", encoding="utf-8") as f:
                    for line in cleaned_bookmarks:
                        f.write(f"{line}\n")
                os.replace(temp_p, self.config.bookmark_file)
            except Exception as e:
                logging.warning(f"Could not rewrite bookmarks file: {e}")

        print(colorize(f"Clean complete. Removed {removed_links} dead symlinks, {removed_dirs} empty folders.", COLOR_GREEN))
        return 0

    def cmd_doctor(self) -> int:
        """Run system diagnostics for GMM prerequisites."""
        print(colorize("GMM System Diagnostics (Doctor)", COLOR_BOLD))
        print("─" * 50)

        # 1. Python & PyGObject
        py_ver = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
        print(f"Python Version     : {py_ver} " + colorize("✓", COLOR_GREEN))

        if HAS_GI and Gio and GLib:
            print("PyGObject (gi)     : Available " + colorize("✓", COLOR_GREEN))
        else:
            print("PyGObject (gi)     : " + colorize("MISSING (Install python3-gi)", COLOR_RED))

        if tomllib:
            print("TOML Parser        : Available " + colorize("✓", COLOR_GREEN))
        else:
            print("TOML Parser        : " + colorize("MISSING (Python 3.11+ required)", COLOR_RED))

        # 2. D-Bus Session
        if self.dbus.is_available():
            print("D-Bus Session Bus  : Connected " + colorize("✓", COLOR_GREEN))
        else:
            print("D-Bus Session Bus  : " + colorize("UNAVAILABLE", COLOR_RED))

        # 3. Backends
        backends = self.dbus.detect_backends()
        if backends:
            print(f"Detected Backends  : {', '.join(backends)} " + colorize("✓", COLOR_GREEN))
        else:
            print("Detected Backends  : " + colorize("None active (Start GSConnect or KDE Connect)", COLOR_YELLOW))

        # 4. Systemd
        has_systemctl = shutil.which("systemctl") is not None
        if has_systemctl:
            print("systemd            : Available " + colorize("✓", COLOR_GREEN))
        else:
            print("systemd            : " + colorize("MISSING", COLOR_YELLOW))

        # 5. GTK Bookmarks
        bm_exists = self.config.bookmark_file.exists()
        if bm_exists:
            print(f"GTK Bookmarks File : {self.config.bookmark_file} " + colorize("✓", COLOR_GREEN))
        else:
            print(f"GTK Bookmarks File : {self.config.bookmark_file} " + colorize("(Will be created)", COLOR_YELLOW))

        return 0

    def cmd_uninstall(self, purge: bool = False, confirm: bool = False) -> int:
        """Uninstall GMM, stop service, and clean up artifacts."""
        if not confirm:
            print("Are you sure you want to uninstall GMM? [y/N]: ", end="", flush=True)
            choice = sys.stdin.readline().strip().lower()
            if choice not in ("y", "yes"):
                print("Uninstallation cancelled.")
                return 0

        print(colorize("Uninstalling GMM...", COLOR_BOLD))

        # 1. Clean symlinks & bookmarks
        self.cmd_clean()

        # 2. Stop & disable systemd user service
        service_name = "gmm.service"
        try:
            subprocess.run(["systemctl", "--user", "stop", service_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "--user", "disable", service_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        # 3. Remove systemd user service file
        service_file = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "systemd" / "user" / service_name
        if service_file.exists():
            try:
                service_file.unlink()
                subprocess.run(["systemctl", "--user", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(f"Removed systemd unit: {service_file}")
            except Exception as e:
                logging.warning(f"Could not remove {service_file}: {e}")

        # 4. Remove config directory if purge requested
        if purge:
            config_dir = self.config.config_path.parent
            if config_dir.exists():
                shutil.rmtree(config_dir, ignore_errors=True)
                print(f"Purged configuration directory: {config_dir}")

        # 5. Remove executable binary if installed in ~/.local/bin/gmm
        bin_path = Path.home() / ".local" / "bin" / "gmm"
        if bin_path.exists():
            try:
                bin_path.unlink()
                print(f"Removed executable: {bin_path}")
            except Exception as e:
                logging.warning(f"Could not remove {bin_path}: {e}")

        print(colorize("GMM has been successfully uninstalled.", COLOR_GREEN))
        return 0


# =============================================================================
# 10. Main Entrypoint
# =============================================================================


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="gmm",
        description="GSConnect / KDE Connect Mount Manager 2.0",
    )
    parser.add_argument(
        "-v", "--version", action="version", version=f"%(prog)s {__version__}"
    )
    parser.add_argument(
        "-c", "--config", type=Path, help="Path to custom config.toml file"
    )
    parser.add_argument(
        "--debug", action="store_true", help="Enable verbose debug logging"
    )

    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # daemon
    subparsers.add_parser("daemon", help="Run the background GMM event daemon")

    # status
    subparsers.add_parser("status", help="Show active mounts, symlinks, and daemon status")

    # list
    subparsers.add_parser("list", help="List paired GSConnect / KDE Connect devices")

    # mount
    mount_parser = subparsers.add_parser("mount", help="Mount a device by name or ID")
    mount_parser.add_argument("device", help="Device name or device ID")

    # unmount
    unmount_parser = subparsers.add_parser("unmount", help="Unmount a device by name or ID")
    unmount_parser.add_argument("device", help="Device name or device ID")

    # clean
    subparsers.add_parser("clean", help="Clean up stale symlinks, empty folders, and dead bookmarks")

    # doctor
    subparsers.add_parser("doctor", help="Run diagnostic checks on system and dependencies")

    # uninstall
    uninstall_parser = subparsers.add_parser("uninstall", help="Uninstall GMM, stop service, and clean up artifacts")
    uninstall_parser.add_argument("--purge", action="store_true", help="Also purge configuration directory")
    uninstall_parser.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")

    args = parser.parse_args()

    # Load configuration
    config = Config.load(args.config)
    if args.debug:
        config.log_level = "DEBUG"

    # Setup logging format
    log_level = getattr(logging, config.log_level, logging.INFO)
    logging.basicConfig(
        level=log_level,
        format="%(asctime)s [%(levelname)s] %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )

    # Dispatch commands
    if args.command == "daemon":
        daemon = GMMDaemon(config)
        daemon.start()
        return 0
    elif args.command == "status":
        cli = CLI(config)
        return cli.cmd_status()
    elif args.command == "list":
        cli = CLI(config)
        return cli.cmd_list()
    elif args.command == "mount":
        cli = CLI(config)
        return cli.cmd_mount(args.device)
    elif args.command == "unmount":
        cli = CLI(config)
        return cli.cmd_unmount(args.device)
    elif args.command == "clean":
        cli = CLI(config)
        return cli.cmd_clean()
    elif args.command == "doctor":
        cli = CLI(config)
        return cli.cmd_doctor()
    elif args.command == "uninstall":
        cli = CLI(config)
        return cli.cmd_uninstall(purge=args.purge, confirm=args.yes)
    else:
        # Default with no arguments: show status
        cli = CLI(config)
        return cli.cmd_status()


if __name__ == "__main__":
    sys.exit(main())
