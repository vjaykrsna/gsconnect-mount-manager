# 5. Atomic GTK Bookmark Manager
# =============================================================================


class BookmarkManager:
    """Manages GTK3/4 bookmarks file safely with atomic writes and flock."""

    def __init__(self, bookmark_file: Path) -> None:
        self.bookmark_file = bookmark_file

    def get_bookmarks(self) -> List[str]:
        """Read all lines from the bookmarks file."""
        if not self.bookmark_file.exists():
            return []
        try:
            with open(self.bookmark_file, "r", encoding="utf-8") as f:
                return [line.strip() for line in f if line.strip()]
        except OSError as e:
            logging.warning(f"Failed to read bookmarks file {self.bookmark_file}: {e}")
            return []

    def update_device_bookmarks(
        self,
        sanitized_name: str,
        partitions: Dict[str, Path],
        sftp_base_uri: str,
        local_device_dir: Path,
        bookmark_mode: str,
    ) -> bool:
        """Atomically add or update bookmarks for a device."""
        if bookmark_mode == "none":
            return True

        self.bookmark_file.parent.mkdir(parents=True, exist_ok=True)

        lock_path = self.bookmark_file.with_suffix(".lock")
        temp_path = self.bookmark_file.with_suffix(".tmp")

        try:
            with open(lock_path, "w", encoding="utf-8") as lock_file:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
                try:
                    lines = []
                    if self.bookmark_file.exists():
                        with open(self.bookmark_file, "r", encoding="utf-8") as f:
                            lines = [line.strip() for line in f if line.strip()]

                    # Remove any existing bookmarks for this device
                    cleaned = [
                        line
                        for line in lines
                        if not (
                            line.endswith(f" {sanitized_name}")
                            or f" {sanitized_name}/" in line
                        )
                    ]

                    # 1. Local directory bookmark (immune to IP address changes)
                    if bookmark_mode in ("both", "local_only"):
                        local_uri = local_device_dir.resolve().as_uri()
                        cleaned.append(f"{local_uri} {sanitized_name}")

                    # 2. Direct SFTP bookmarks for partitions
                    if bookmark_mode in ("both", "sftp_only"):
                        clean_base = sftp_base_uri.rstrip("/")
                        for label, p_path in partitions.items():
                            # Find relative path from GVfs SFTP mount root
                            # Example p_path: /run/user/1000/gvfs/sftp:host=1.2.3.4,port=1739/storage/emulated/0
                            match = re.search(r"sftp:[^/]+(/(.*))$", str(p_path))
                            if match:
                                rel_path = match.group(1)
                            else:
                                rel_path = f"/storage/{p_path.name}"
                            sftp_uri = f"{clean_base}{rel_path}"
                            cleaned.append(f"{sftp_uri} {sanitized_name}/{label}")

                    # Write atomically via tempfile
                    with open(temp_path, "w", encoding="utf-8") as tf:
                        for item in cleaned:
                            tf.write(f"{item}\n")
                        tf.flush()
                        os.fsync(tf.fileno())

                    os.replace(temp_path, self.bookmark_file)
                    logging.info(f"Updated GTK bookmarks for {sanitized_name}")
                    return True

                finally:
                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)

        except Exception as e:
            logging.error(f"Error updating bookmark file: {e}")
            if temp_path.exists():
                try:
                    temp_path.unlink()
                except OSError:
                    pass
            return False

    def remove_device_bookmarks(self, sanitized_name: str) -> bool:
        """Remove all bookmarks associated with a device name."""
        if not self.bookmark_file.exists():
            return True

        lock_path = self.bookmark_file.with_suffix(".lock")
        temp_path = self.bookmark_file.with_suffix(".tmp")

        try:
            with open(lock_path, "w", encoding="utf-8") as lock_file:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
                try:
                    lines = []
                    with open(self.bookmark_file, "r", encoding="utf-8") as f:
                        lines = [line.strip() for line in f if line.strip()]

                    cleaned = [
                        line
                        for line in lines
                        if not (
                            line.endswith(f" {sanitized_name}")
                            or f" {sanitized_name}/" in line
                        )
                    ]

                    if len(cleaned) == len(lines):
                        return True  # Nothing to remove

                    with open(temp_path, "w", encoding="utf-8") as tf:
                        for item in cleaned:
                            tf.write(f"{item}\n")
                        tf.flush()
                        os.fsync(tf.fileno())

                    os.replace(temp_path, self.bookmark_file)
                    logging.info(f"Removed GTK bookmarks for {sanitized_name}")
                    return True

                finally:
                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)

        except Exception as e:
            logging.error(f"Error removing device bookmarks for {sanitized_name}: {e}")
            if temp_path.exists():
                try:
                    temp_path.unlink()
                except OSError:
                    pass
            return False


