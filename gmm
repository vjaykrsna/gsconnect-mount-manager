# 5. Atomic GTK Bookmark Manager
# =============================================================================


class BookmarkManager:
    """Update GTK bookmarks while tracking the exact entries created by GMM."""

    def __init__(self, bookmark_file: Path) -> None:
        self.bookmark_file = bookmark_file
        self.state_file = bookmark_file.with_name("gmm-bookmarks.json")

    def get_bookmarks(self) -> List[str]:
        try:
            return self.bookmark_file.read_text(encoding="utf-8").splitlines()
        except FileNotFoundError:
            return []

    def _change(self, transform) -> int:
        self.bookmark_file.parent.mkdir(parents=True, exist_ok=True)
        lock_path = self.bookmark_file.with_suffix(".lock")
        with open(lock_path, "a", encoding="utf-8") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                lines = self.get_bookmarks()
                try:
                    state = json.loads(self.state_file.read_text(encoding="utf-8"))
                    if not isinstance(state, dict):
                        raise ValueError("Invalid bookmark state")
                except FileNotFoundError:
                    state = {}
                new_lines, new_state, count = transform(lines, state)
                if new_lines != lines:
                    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=self.bookmark_file.parent, delete=False) as tmp:
                        tmp_path = Path(tmp.name)
                        try:
                            tmp.write("".join(line + "\n" for line in new_lines))
                            tmp.flush()
                            os.fsync(tmp.fileno())
                        except BaseException:
                            tmp_path.unlink(missing_ok=True)
                            raise
                    os.replace(tmp_path, self.bookmark_file)
                if new_state != state:
                    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=self.state_file.parent, delete=False) as tmp:
                        json.dump(new_state, tmp)
                        tmp_path = Path(tmp.name)
                    os.replace(tmp_path, self.state_file)
                return count
            finally:
                fcntl.flock(lock, fcntl.LOCK_UN)

    def update_device_bookmarks(self, sanitized_name: str, partitions: Dict[str, Path],
                                sftp_base_uri: str, local_device_dir: Path,
                                bookmark_mode: str, mount_path: Optional[Path] = None) -> bool:
        if bookmark_mode == "none":
            return True
        local_uri = local_device_dir.absolute().as_uri()
        additions = []
        if bookmark_mode in ("both", "local_only"):
            additions.append(f"{local_uri} {sanitized_name}")
        if bookmark_mode in ("both", "sftp_only"):
            for label, path in partitions.items():
                try:
                    relative = path.resolve().relative_to(mount_path.resolve()) if mount_path else None
                except (ValueError, RuntimeError):
                    continue
                if relative is None:
                    match = re.search(r"sftp:[^/]+(/.*)?$", str(path))
                    rel = match.group(1) or "" if match else ("/storage/emulated/0" if path.name == "0" else f"/storage/{path.name}")
                else:
                    rel = "" if str(relative) == "." else "/" + urllib.parse.quote(relative.as_posix(), safe="/")
                additions.append(f"{sftp_base_uri.rstrip('/')}{rel} {sanitized_name}/{label}")
        def update(lines, state):
            old = state.get(local_uri, [])
            result = [line for line in lines if line not in old]
            owned = [line for line in additions if line not in result]
            result.extend(owned)
            updated = dict(state)
            updated[local_uri] = owned
            return result, updated, len(owned)
        try:
            self._change(update)
            return True
        except (OSError, ValueError, TypeError) as e:
            logging.error("Error updating bookmarks: %s", e)
            return False

    def remove_device_bookmarks(self, sanitized_name: str, local_uri: Optional[str] = None) -> bool:
        def remove(lines, state):
            keys = [local_uri] if local_uri else [key for key, entries in state.items()
                if any(line.partition(" ")[2] == sanitized_name or
                       line.partition(" ")[2].startswith(sanitized_name + "/") for line in entries)]
            owned = {line for key in keys for line in state.get(key, [])}
            result = [line for line in lines if line not in owned]
            updated = {key: value for key, value in state.items() if key not in keys}
            return result, updated, len(lines) - len(result)
        try:
            self._change(remove)
            return True
        except (OSError, ValueError, TypeError) as e:
            logging.error("Error removing bookmarks: %s", e)
            return False

    def clean_bookmarks(self, mount_dir: Path) -> int:
        def clean(lines, state):
            updated = dict(state)
            removed = set()
            for uri, entries in state.items():
                parsed = urllib.parse.urlparse(uri)
                path = Path(urllib.parse.unquote(parsed.path))
                if parsed.scheme == "file" and is_safe_subpath(path, mount_dir) and not path.exists():
                    removed.update(entries)
                    del updated[uri]
            result = [line for line in lines if line not in removed]
            return result, updated, len(lines) - len(result)
        try:
            return self._change(clean)
        except (OSError, ValueError, TypeError) as e:
            logging.error("Error cleaning bookmarks: %s", e)
            return 0


