# 8. Event-Driven Daemon
# =============================================================================


class GMMDaemon:
    """Core event-driven daemon using Gio.VolumeMonitor (zero polling)."""

    def __init__(self, config: Config) -> None:
        self.config = config
        self.dbus = DBusHelper()
        self.scanner = StorageScanner(config)
        self.bookmarks = BookmarkManager(config.bookmark_file)
        self.controller = DeviceController(config)
        self.notifier = DesktopNotifier(enabled=config.notifications)
        self.loop: Optional[GLib.MainLoop] = None
        self.volume_monitor: Optional[Gio.VolumeMonitor] = None

    def start(self) -> None:
        """Start the background GLib event loop."""
        if not HAS_GI or not Gio:
            logging.error("PyGObject (gi.repository.Gio) is required to run the GMM daemon.")
            sys.exit(1)

        logging.info(f"Starting GMM Daemon (v{__version__})...")
        logging.info(f"Base Directory: {self.config.mount_structure_dir}")
        logging.info(f"Bookmark Mode: {self.config.bookmark_mode}")

        # Ensure default configuration exists
        try:
            self.config.save_default()
        except OSError as e:
            logging.debug(f"Could not write default config: {e}")

        self.volume_monitor = Gio.VolumeMonitor.get()
        self.volume_monitor.connect("mount-added", self._on_mount_added)
        self.volume_monitor.connect("mount-removed", self._on_mount_removed)
        self.volume_monitor.connect("mount-changed", self._on_mount_changed)

        # Initial reconciliation: inspect already active mounts
        self._reconcile_existing_mounts()

        # Auto-mount setup if enabled
        if self.config.auto_mount:
            self._setup_auto_mount()

        # Handle Unix termination signals
        self.loop = GLib.MainLoop()
        if HAS_GI and GLib and hasattr(GLib, "unix_signal_add"):
            try:
                GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, self._glib_signal_handler, signal.SIGINT)
                GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, self._glib_signal_handler, signal.SIGTERM)
            except Exception:
                signal.signal(signal.SIGINT, self._handle_signal)
                signal.signal(signal.SIGTERM, self._handle_signal)
        else:
            signal.signal(signal.SIGINT, self._handle_signal)
            signal.signal(signal.SIGTERM, self._handle_signal)

        logging.info("GMM Daemon active and listening for mount events.")
        try:
            self.loop.run()
        except (KeyboardInterrupt, SystemExit):
            self.stop()

    def _setup_auto_mount(self) -> None:
        """Trigger initial auto-mount and subscribe to D-Bus device reachability signals."""
        if not self.dbus.is_available():
            return

        logging.info("Auto-mount enabled. Checking paired devices...")
        try:
            for dev in self.dbus.get_all_devices():
                if dev.is_reachable and not dev.is_mounted:
                    logging.info(f"Auto-mounting online device: {dev.name} ({dev.backend})")
                    if dev.backend == "kdeconnect":
                        self.dbus.mount_kde_device(dev.id)
                    elif dev.backend == "gsconnect":
                        self.dbus.mount_gsconnect_device(dev.id)
        except Exception as e:
            logging.debug(f"Error checking devices for auto-mount: {e}")

        # Subscribe to D-Bus signals for real-time connection events
        if self.dbus.bus:
            try:
                # KDE Connect: reachableChanged on org.kde.kdeconnect.device
                self.dbus.bus.signal_subscribe(
                    "org.kde.kdeconnect",
                    "org.kde.kdeconnect.device",
                    "reachableChanged",
                    None,
                    None,
                    Gio.DBusSignalFlags.NONE,
                    self._on_kde_reachable_changed,
                    None,
                )
            except Exception as e:
                logging.debug(f"Could not subscribe to KDE Connect reachableChanged: {e}")

            try:
                # GSConnect: PropertiesChanged on org.freedesktop.DBus.Properties
                self.dbus.bus.signal_subscribe(
                    "org.gnome.Shell.Extensions.GSConnect",
                    "org.freedesktop.DBus.Properties",
                    "PropertiesChanged",
                    None,
                    None,
                    Gio.DBusSignalFlags.NONE,
                    self._on_gsconnect_properties_changed,
                    None,
                )
            except Exception as e:
                logging.debug(f"Could not subscribe to GSConnect PropertiesChanged: {e}")

    def _on_kde_reachable_changed(self, connection, sender, object_path, interface_name, signal_name, parameters, user_data) -> None:
        try:
            is_reachable = parameters.unpack()[0]
            if is_reachable:
                dev_id = object_path.split("/")[-1]
                logging.info(f"KDE Connect device {dev_id} joined network. Auto-mounting...")
                self.dbus.mount_kde_device(dev_id)
        except Exception as e:
            logging.debug(f"Error in KDE reachableChanged signal: {e}")

    def _on_gsconnect_properties_changed(self, connection, sender, object_path, interface_name, signal_name, parameters, user_data) -> None:
        try:
            if "/Device/" in object_path:
                unpacked = parameters.unpack()
                changed_props = unpacked[1]
                if changed_props.get("Connected") is True or changed_props.get("connected") is True:
                    dev_id = object_path.split("/Device/")[-1]
                    logging.info(f"GSConnect device {dev_id} connected. Auto-mounting...")
                    self.dbus.mount_gsconnect_device(dev_id)
        except Exception as e:
            logging.debug(f"Error in GSConnect PropertiesChanged signal: {e}")

    def stop(self) -> None:
        """Clean shutdown of daemon."""
        logging.info("Shutting down GMM Daemon...")
        if self.loop and self.loop.is_running():
            self.loop.quit()

    def _handle_signal(self, signum: int, frame: Any) -> None:
        logging.info(f"Received termination signal ({signum}).")
        self.stop()

    def _glib_signal_handler(self, signum: int) -> bool:
        logging.info(f"Received termination signal ({signum}).")
        self.stop()
        return GLib.SOURCE_REMOVE if (HAS_GI and GLib) else False

    def _reconcile_existing_mounts(self) -> None:
        """Check for existing SFTP mounts already present when daemon launches."""
        if not self.volume_monitor:
            return

        mounts = self.volume_monitor.get_mounts()
        for mount in mounts:
            try:
                root = mount.get_root()
                if root and root.get_uri_scheme() == "sftp":
                    self._process_mount(mount)
            except Exception as e:
                logging.debug(f"Error inspecting mount on startup: {e}")

    def _on_mount_added(self, monitor: Any, mount: Gio.Mount) -> None:
        try:
            root = mount.get_root()
            if root and root.get_uri_scheme() == "sftp":
                logging.info(f"Mount added event detected: {mount.get_name()}")
                self._process_mount(mount)
        except Exception as e:
            logging.error(f"Error handling mount-added event: {e}")

    def _on_mount_removed(self, monitor: Any, mount: Gio.Mount) -> None:
        try:
            root = mount.get_root()
            if root and root.get_uri_scheme() == "sftp":
                uri = root.get_uri()
                logging.info(f"Mount removed event detected: {uri}")
                active = self.controller.teardown_device(uri)
                if active:
                    self.bookmarks.remove_device_bookmarks(
                        active.sanitized_name,
                        local_uri=active.device_dir.resolve().as_uri(),
                    )
                    self.notifier.notify(
                        "Storage Disconnected",
                        f"{active.name} storage has been unmounted.",
                        icon="media-eject",
                    )
        except Exception as e:
            logging.error(f"Error handling mount-removed event: {e}")

    def _on_mount_changed(self, monitor: Any, mount: Gio.Mount) -> None:
        try:
            root = mount.get_root()
            if root and root.get_uri_scheme() == "sftp":
                self._process_mount(mount)
        except Exception as e:
            logging.debug(f"Error handling mount-changed: {e}")

    def _process_mount(self, mount: Gio.Mount) -> None:
        """Extract mount location, discover partitions, setup symlinks and bookmarks."""
        root = mount.get_root()
        uri = root.get_uri()

        location = mount.get_default_location()
        if not location:
            return
        mount_path_str = location.get_path()
        if not mount_path_str:
            return
        mount_path = Path(mount_path_str)

        # A host must uniquely identify a paired device. Never infer ownership from
        # the number of reachable devices or a partial name match.
        host = urllib.parse.urlparse(uri).hostname
        devices = [d for d in self.dbus.get_all_devices()
                   if host and d.host and d.host.casefold() == host.casefold()]
        if len(devices) != 1:
            logging.debug("Ignoring SFTP mount without a unique paired device: %s", uri)
            return
        device = devices[0]
        display_name = managed_device_name(device)

        # Discover partitions
        partitions = self.scanner.discover(mount_path)
        if not partitions:
            logging.warning(
                f"No accessible storage partitions found under {mount_path} for {display_name}"
            )

        # Setup local directory and symlinks
        active = self.controller.setup_device(uri, display_name, mount_path, partitions)
        if active:
            # Update GTK bookmarks
            self.bookmarks.update_device_bookmarks(
                active.sanitized_name,
                partitions,
                uri,
                active.device_dir,
                self.config.bookmark_mode,
                mount_path=mount_path,
            )
            # Desktop notification
            partition_names = ", ".join(partitions.keys()) or "Storage"
            self.notifier.notify(
                "Storage Connected",
                f"{display_name} ({partition_names}) ready in {active.device_dir}",
                icon="phone",
                action_path=active.device_dir,
            )

    def _resolve_display_name(self, raw_name: str, uri: str) -> str:
        """Resolve friendly device name from D-Bus without multi-device misattribution."""
        # Generic names look like "sftp on 192.168.1.50:1739" or similar
        if not raw_name or "sftp on" in raw_name.lower() or raw_name.startswith("sftp:"):
            parsed_uri = urllib.parse.urlparse(uri)
            host = parsed_uri.hostname

            devices = self.dbus.get_all_devices()
            # 1. Match directly by host/IP if known
            if host:
                for dev in devices:
                    if dev.host == host and dev.name:
                        return dev.name

            # 2. Match device name inside raw_name (e.g. "sftp on Pixel 7:1739")
            if raw_name:
                for dev in devices:
                    if dev.name and dev.name.lower() in raw_name.lower():
                        return dev.name

            # 3. If exactly one device is reachable, safely attribute to it
            reachable_devs = [d for d in devices if d.is_reachable and d.name]
            if len(reachable_devs) == 1:
                return reachable_devs[0].name

            # 4. Fallback to host IP rather than misattributing to the first device
            return host or "Android_Device"

        return raw_name


