@dataclass
class ActiveDevice:
    uri: str
    name: str
    sanitized_name: str
    device_dir: Path
    mount_path: Path
    partitions: Dict[str, Path]
    host: Optional[str] = None
    port: Optional[int] = None


class DeviceController:
    """Manages local ~/Devices/<Device-Name>/ directories and symlinks."""

    def __init__(self, config: Config) -> None:
        self.config = config
        self.active_devices: Dict[str, ActiveDevice] = {}

    def setup_device(
        self,
        uri: str,
        display_name: str,
        mount_path: Path,
        partitions: Dict[str, Path],
    ) -> Optional[ActiveDevice]:
        """Create directory structure and symlinks for a connected device."""
        sanitized = sanitize_device_name(display_name)
        device_dir = self.config.mount_structure_dir / sanitized

        # Validate that device_dir is safely inside mount_structure_dir
        if not is_safe_subpath(device_dir, self.config.mount_structure_dir):
            logging.error(
                f"Path safety check failed: {device_dir} is not inside {self.config.mount_structure_dir}"
            )
            return None

        device_dir.mkdir(parents=True, exist_ok=True)

        # Create or update partition symlinks
        for label, target in partitions.items():
            symlink = device_dir / label
            try:
                if symlink.is_symlink():
                    if symlink.resolve() != target.resolve():
                        symlink.unlink()
                        symlink.symlink_to(target)
                        logging.info(f"Updated symlink: {symlink} -> {target}")
                elif symlink.exists():
                    logging.warning(f"Path exists and is not a symlink: {symlink}, skipping.")
                else:
                    symlink.symlink_to(target)
                    logging.info(f"Created symlink: {symlink} -> {target}")
            except OSError as e:
                logging.error(f"Failed to create symlink {symlink} -> {target}: {e}")

        # Parse host and port from URI (sftp://host:port/)
        host = None
        port = None
        match = re.search(r"sftp://([^:/]+)(?::([0-9]+))?", uri)
        if match:
            host = match.group(1)
            port = int(match.group(2)) if match.group(2) else 1739

        active = ActiveDevice(
            uri=uri,
            name=display_name,
            sanitized_name=sanitized,
            device_dir=device_dir,
            mount_path=mount_path,
            partitions=partitions,
            host=host,
            port=port,
        )
        self.active_devices[uri] = active
        return active

    def teardown_device(self, uri: str) -> Optional[ActiveDevice]:
        """Clean up symlinks and directories when a device disconnects."""
        active = self.active_devices.pop(uri, None)
        if not active:
            return None

        if self.config.auto_cleanup and active.device_dir.exists():
            # Remove managed symlinks
            for child in list(active.device_dir.iterdir()):
                if child.is_symlink():
                    try:
                        child.unlink()
                        logging.debug(f"Removed symlink: {child}")
                    except OSError as e:
                        logging.warning(f"Could not remove symlink {child}: {e}")

            # Remove directory if empty
            try:
                if not any(active.device_dir.iterdir()):
                    active.device_dir.rmdir()
                    logging.info(f"Removed device directory: {active.device_dir}")
            except OSError as e:
                logging.debug(f"Directory not empty or could not be removed: {e}")

        return active


