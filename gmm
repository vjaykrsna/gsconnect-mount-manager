def main() -> int:
    parser = argparse.ArgumentParser(
        prog="gmm",
        description=f"GSConnect / KDE Connect Mount Manager {__version__}",
    )
    parser.add_argument(
        "-v", "--version", action="version", version=f"%(prog)s {__version__}"
    )
    parser.add_argument(
        "-c", "--config", type=Path, help="Path to custom config.toml file"
    )
    parser.add_argument(
        "--debug", action="store_true", help="Enable verbose debug logging"
    )

    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # daemon
    subparsers.add_parser("daemon", help="Run the background GMM event daemon")

    # status
    subparsers.add_parser("status", help="Show active mounts, symlinks, and daemon status")

    # list
    subparsers.add_parser("list", help="List paired GSConnect / KDE Connect devices")

    # mount
    mount_parser = subparsers.add_parser("mount", help="Mount a device (or all devices if omitted)")
    mount_parser.add_argument("device", nargs="?", default=None, help="Device name or ID (omit to mount all)")

    # unmount
    unmount_parser = subparsers.add_parser("unmount", help="Unmount a device (or all devices if omitted)")
    unmount_parser.add_argument("device", nargs="?", default=None, help="Device name or ID (omit to unmount all)")

    # clean
    subparsers.add_parser("clean", help="Clean up stale symlinks, empty folders, and dead bookmarks")

    # config
    config_parser = subparsers.add_parser("config", help="Inspect or initialize configuration")
    config_parser.add_argument("--path", action="store_true", help="Print path to config.toml")
    config_parser.add_argument("--init", action="store_true", help="Initialize default config.toml if missing")

    # doctor
    doctor_parser = subparsers.add_parser("doctor", help="Run diagnostic checks on system and dependencies")
    doctor_parser.add_argument("--export", action="store_true", help="Export diagnostic report as Markdown for bug reporting")

    # update
    subparsers.add_parser("update", help="Update GMM to the latest version from GitHub")

    # uninstall
    uninstall_parser = subparsers.add_parser("uninstall", help="Uninstall GMM, stop service, and clean up artifacts")
    uninstall_parser.add_argument("--purge", action="store_true", help="Also purge configuration directory")
    uninstall_parser.add_argument("-y", "--yes", "--force", action="store_true", help="Skip confirmation prompt")

    args = parser.parse_args()

    # Load configuration
    config = Config.load(args.config)
    if args.debug:
        config.log_level = "DEBUG"

    # Setup logging format
    log_level = getattr(logging, config.log_level, logging.INFO)
    logging.basicConfig(
        level=log_level,
        format="%(asctime)s [%(levelname)s] %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )

    # Dispatch commands
    if args.command == "daemon":
        daemon = GMMDaemon(config)
        daemon.start()
        return 0
    elif args.command == "status":
        cli = CLI(config)
        return cli.cmd_status()
    elif args.command == "list":
        cli = CLI(config)
        return cli.cmd_list()
    elif args.command == "mount":
        cli = CLI(config)
        return cli.cmd_mount(args.device)
    elif args.command == "unmount":
        cli = CLI(config)
        return cli.cmd_unmount(args.device)
    elif args.command == "clean":
        cli = CLI(config)
        return cli.cmd_clean()
    elif args.command == "config":
        cli = CLI(config)
        return cli.cmd_config(show_path=args.path, init=args.init)
    elif args.command == "doctor":
        cli = CLI(config)
        return cli.cmd_doctor(export=args.export)
    elif args.command == "update":
        cli = CLI(config)
        return cli.cmd_update()
    elif args.command == "uninstall":
        cli = CLI(config)
        return cli.cmd_uninstall(purge=args.purge, confirm=args.yes)
    else:
        # Default with no arguments: show status
        cli = CLI(config)
        return cli.cmd_status()


if __name__ == "__main__":
    sys.exit(main())
