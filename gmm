# 6. Local Symlinks & Device Controller
# =============================================================================


@dataclass
class ActiveDevice:
    uri: str
    name: str
    sanitized_name: str
    device_dir: Path
    mount_path: Path
    partitions: Dict[str, Path]
    host: Optional[str] = None
    port: Optional[int] = None


class DeviceController:
    """Manages local ~/Devices/<Device-Name>/ directories and symlinks."""

    def __init__(self, config: Config) -> None:
        self.config = config
        self.active_devices: Dict[str, ActiveDevice] = {}

    def setup_device(
        self,
        uri: str,
        display_name: str,
        mount_path: Path,
        partitions: Dict[str, Path],
    ) -> Optional[ActiveDevice]:
        """Create directory structure and symlinks for a connected device."""
        sanitized = sanitize_device_name(display_name)
        device_dir = self.config.mount_structure_dir / sanitized

        # Validate that device_dir is safely inside mount_structure_dir
        if not is_safe_subpath(device_dir, self.config.mount_structure_dir):
            logging.error(
                f"Path safety check failed: {device_dir} is not inside {self.config.mount_structure_dir}"
            )
            return None

        device_dir.mkdir(parents=True, exist_ok=True)

        # Only links recorded in our manifest may be replaced or removed.
        manifest = device_dir / ".gmm-links.json"
        try:
            if manifest.is_symlink():
                raise ValueError("link manifest is a symlink")
            managed = json.loads(manifest.read_text(encoding="utf-8"))
            if not isinstance(managed, dict):
                raise ValueError("invalid link manifest")
        except FileNotFoundError:
            managed = {}
        except (OSError, ValueError) as e:
            logging.error("Cannot read link manifest %s: %s", manifest, e)
            return None

        for label, old_target in list(managed.items()):
            link = device_dir / label
            if Path(label).name != label:
                continue
            if link.is_symlink() and os.readlink(link) == old_target and label not in partitions:
                link.unlink()
                del managed[label]

        for label, target in partitions.items():
            if not label or Path(label).name != label or label in (".", "..", manifest.name):
                logging.warning("Ignoring invalid partition label: %r", label)
                continue
            link = device_dir / label
            target_str = str(target)
            try:
                if link.is_symlink():
                    current = os.readlink(link)
                    if managed.get(label) != current:
                        logging.warning("Preserving unowned symlink: %s", link)
                        continue
                    if current != target_str:
                        link.unlink()
                        link.symlink_to(target)
                elif link.exists():
                    logging.warning("Preserving existing path: %s", link)
                    continue
                else:
                    link.symlink_to(target)
                managed[label] = target_str
            except OSError as e:
                logging.error("Failed to create symlink %s: %s", link, e)
        manifest.write_text(json.dumps(managed), encoding="utf-8")

        # Parse host and port from URI (sftp://host:port/)
        parsed_uri = urllib.parse.urlparse(uri)
        host = parsed_uri.hostname
        port = parsed_uri.port or 1739

        active = ActiveDevice(
            uri=uri,
            name=display_name,
            sanitized_name=sanitized,
            device_dir=device_dir,
            mount_path=mount_path,
            partitions=partitions,
            host=host,
            port=port,
        )
        self.active_devices[uri] = active
        return active

    @staticmethod
    def cleanup_managed_links(device_dir: Path, stale_only: bool = False) -> int:
        if device_dir.is_symlink() or not device_dir.is_dir():
            return 0
        manifest = device_dir / ".gmm-links.json"
        try:
            if manifest.is_symlink():
                raise ValueError("link manifest is a symlink")
            managed = json.loads(manifest.read_text(encoding="utf-8"))
            if not isinstance(managed, dict):
                return 0
        except (OSError, ValueError):
            return 0
        removed = 0
        remaining = dict(managed)
        for label, target in managed.items():
            if not isinstance(label, str) or Path(label).name != label or not isinstance(target, str):
                continue
            link = device_dir / label
            try:
                if link.is_symlink() and os.readlink(link) == target:
                    if stale_only and link.exists():
                        continue
                    link.unlink()
                    removed += 1
                remaining.pop(label, None)
            except OSError as e:
                logging.warning("Could not clean %s: %s", link, e)
        if remaining:
            manifest.write_text(json.dumps(remaining), encoding="utf-8")
        else:
            manifest.unlink(missing_ok=True)
        return removed

    def teardown_device(self, uri: str) -> Optional[ActiveDevice]:
        """Clean up symlinks and directories when a device disconnects."""
        active = self.active_devices.pop(uri, None)
        if not active:
            alt_uri = uri.rstrip("/") if uri.endswith("/") else f"{uri}/"
            active = self.active_devices.pop(alt_uri, None)
        if not active:
            return None

        if self.config.auto_cleanup and active.device_dir.exists():
            self.cleanup_managed_links(active.device_dir)

            # Remove directory if empty
            try:
                if not any(active.device_dir.iterdir()):
                    active.device_dir.rmdir()
                    logging.info(f"Removed device directory: {active.device_dir}")
            except OSError as e:
                logging.debug(f"Directory not empty or could not be removed: {e}")

            # Remove base directory if empty and not Home directory
            base_dir = self.config.mount_structure_dir.resolve()
            if base_dir != Path.home().resolve() and base_dir.exists():
                try:
                    if not any(base_dir.iterdir()):
                        base_dir.rmdir()
                        logging.info(f"Removed empty base directory: {base_dir}")
                except OSError as e:
                    logging.debug(f"Base directory not empty or could not be removed: {e}")

        return active


