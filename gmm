class DesktopNotifier:
    """Delivers non-intrusive desktop notifications on connection events."""

    def __init__(self, enabled: bool = True) -> None:
        self.enabled = enabled

    def notify(
        self,
        title: str,
        message: str,
        icon: str = "phone",
        action_path: Optional[Path] = None,
    ) -> None:
        if not self.enabled:
            return

        # Attempt notify-send first (standard on Linux desktops)
        if shutil.which("notify-send"):
            cmd = ["notify-send", "-a", "GMM", "-i", icon, title, message]
            try:
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except Exception:
                pass

        # Fallback to Gio.Notification if available
        if HAS_GI and Gio:
            try:
                app = Gio.Application.get_default()
                if app:
                    n = Gio.Notification.new(title)
                    n.set_body(message)
                    app.send_notification("gmm-event", n)
            except Exception:
                pass


