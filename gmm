# 4. Storage Discovery
# =============================================================================


class StorageScanner:
    """Discovers internal and external storage paths from a mounted filesystem."""

    UUID_REGEX = re.compile(r"^[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}$")

    def __init__(self, config: Config) -> None:
        self.config = config

    def discover(self, mount_path: Path) -> Dict[str, Path]:
        """Inspect mount_path and return mapping of partition label to local path."""
        partitions: Dict[str, Path] = {}
        if not mount_path.exists() or not mount_path.is_dir():
            return partitions

        storage_root = mount_path / "storage"

        saf_indicators = ["DCIM", "Download", "Documents", "Pictures", "Android", "Music", "Movies"]

        # 1. Standard Android Internal Storage: /storage/emulated/0
        internal_path = storage_root / "emulated" / "0"
        if internal_path.exists() and internal_path.is_dir():
            partitions["Internal"] = internal_path
            logging.debug(f"Discovered Internal storage: {internal_path}")
        else:
            # Fallback for Android SAF or KDE Connect mount roots where DCIM/Download are at root
            if any((mount_path / indicator).exists() for indicator in saf_indicators):
                partitions["Internal"] = mount_path
                logging.debug(f"Discovered root-mapped Internal storage (SAF): {mount_path}")

        # 2. Dynamic MicroSD / USB-OTG Detection via Volume UUIDs
        if self.config.auto_discover and storage_root.exists() and storage_root.is_dir():
            sd_count = 0
            try:
                for entry in sorted(storage_root.iterdir()):
                    if entry.is_dir():
                        name = entry.name
                        if name in self.config.exclude_directories:
                            continue

                        # Check for 8-char hex volume UUID (e.g., 3C82-16F4)
                        if self.UUID_REGEX.match(name):
                            sd_count += 1
                            label = "SDCard" if sd_count == 1 else f"SDCard-{sd_count}"
                            partitions[label] = entry
                            logging.debug(f"Discovered external storage ({label}): {entry}")
                        elif name != "emulated":
                            # Non-UUID, non-emulated directory under /storage
                            partitions[name] = entry
                            logging.debug(f"Discovered custom storage directory: {entry}")
            except (PermissionError, OSError) as e:
                logging.warning(f"Could not fully scan {storage_root}: {e}")
        elif self.config.auto_discover and not partitions:
            # Android SAF trees exposed as subdirectories of mount_path (e.g. "Internal storage", "SD card")
            try:
                for entry in sorted(mount_path.iterdir()):
                    if entry.is_dir() and not entry.name.startswith("."):
                        low_name = entry.name.lower()
                        if "internal" in low_name or "primary" in low_name:
                            partitions["Internal"] = entry
                            logging.debug(f"Discovered SAF Internal storage folder: {entry}")
                        elif "sd" in low_name or "card" in low_name or "external" in low_name:
                            partitions["SDCard"] = entry
                            logging.debug(f"Discovered SAF SDCard folder: {entry}")
                        elif any((entry / ind).exists() for ind in saf_indicators):
                            partitions[entry.name] = entry
                            logging.debug(f"Discovered SAF media folder: {entry}")
            except (PermissionError, OSError) as e:
                logging.debug(f"Could not scan mount root subdirectories: {e}")

        # 3. User-defined custom paths from config (with path traversal protection)
        for custom_entry in self.config.custom_paths:
            if ":" in custom_entry:
                rel_path, label = custom_entry.split(":", 1)
                full_custom_path = (mount_path / rel_path.lstrip("/")).resolve()
                if (
                    is_safe_subpath(full_custom_path, mount_path)
                    and full_custom_path.exists()
                    and full_custom_path.is_dir()
                ):
                    partitions[label.strip()] = full_custom_path
                    logging.debug(f"Added configured custom path ({label}): {full_custom_path}")

        # 4. Final fallback: If nothing matched but mount_path contains readable entries
        if not partitions:
            try:
                entries = [e for e in mount_path.iterdir() if not e.name.startswith(".")]
                if entries:
                    partitions["Storage"] = mount_path
                    logging.debug(f"Discovered generic storage root: {mount_path}")
            except (PermissionError, OSError):
                pass

        return partitions


