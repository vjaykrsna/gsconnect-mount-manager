DEFAULT_CONFIG_TOML = """# GMM (GSConnect Mount Manager) Configuration File
# Version 2.0.1

[general]
# Base directory where device symlinks are organized
# Default: "~/Devices"
mount_structure_dir = "~/Devices"

# GTK bookmark creation mode:
#   "both"       - Creates direct SFTP bookmarks AND local folder bookmarks (immune to IP changes)
#   "sftp_only"  - Creates direct SFTP bookmarks only (e.g. sftp://host:port/storage/emulated/0)
#   "local_only" - Creates local directory bookmarks only (file://$HOME/Devices/Phone)
#   "none"       - Disables bookmark generation
bookmark_mode = "both"

# Show desktop notifications when storage is connected or disconnected
notifications = true

# Automatically trigger SFTP mounting when a paired device connects to Wi-Fi
auto_mount = true

# Clean up empty device directories and dangling links on disconnect
auto_cleanup = true

[storage]
# Automatically discover Internal and SD Card UUID partitions
auto_discover = true

# Exclude internal Android pseudo-directories from symlinking
exclude_directories = ["self", "knox", "legacy", "sdcard"]

# Custom storage paths (optional override). Format: ["/mount/path:DisplayName"]
# Example: custom_paths = ["/storage/custom_dir:CustomStorage"]
custom_paths = []

[logging]
# Log verbosity: "DEBUG", "INFO", "WARNING", "ERROR"
level = "INFO"
"""


@dataclass
class Config:
    mount_structure_dir: Path = field(default_factory=lambda: Path.home() / "Devices")
    bookmark_mode: str = "both"  # "both", "sftp_only", "local_only", "none"
    notifications: bool = True
    auto_mount: bool = True
    auto_cleanup: bool = True
    auto_discover: bool = True
    exclude_directories: List[str] = field(
        default_factory=lambda: ["self", "knox", "legacy", "sdcard"]
    )
    custom_paths: List[str] = field(default_factory=list)
    log_level: str = "INFO"
    config_path: Path = field(
        default_factory=lambda: Path(
            os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")
        )
        / "gmm"
        / "config.toml"
    )
    bookmark_file: Path = field(
        default_factory=lambda: Path(
            os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")
        )
        / "gtk-3.0"
        / "bookmarks"
    )

    @classmethod
    def load(cls, config_path: Optional[Path] = None) -> "Config":
        cfg = cls()
        if config_path:
            cfg.config_path = config_path.expanduser().resolve()

        if cfg.config_path.exists() and tomllib is not None:
            try:
                with open(cfg.config_path, "rb") as f:
                    data = tomllib.load(f)

                general = data.get("general", {})
                if "mount_structure_dir" in general:
                    cfg.mount_structure_dir = Path(
                        os.path.expandvars(general["mount_structure_dir"])
                    ).expanduser().resolve()
                if "bookmark_mode" in general:
                    val = str(general["bookmark_mode"]).lower()
                    if val in ("both", "sftp_only", "local_only", "none"):
                        cfg.bookmark_mode = val
                if "notifications" in general:
                    cfg.notifications = bool(general["notifications"])
                if "auto_mount" in general:
                    cfg.auto_mount = bool(general["auto_mount"])
                if "auto_cleanup" in general:
                    cfg.auto_cleanup = bool(general["auto_cleanup"])

                storage = data.get("storage", {})
                if "auto_discover" in storage:
                    cfg.auto_discover = bool(storage["auto_discover"])
                if "exclude_directories" in storage:
                    cfg.exclude_directories = [
                        str(x) for x in storage["exclude_directories"]
                    ]
                if "custom_paths" in storage:
                    cfg.custom_paths = [str(x) for x in storage["custom_paths"]]

                logging_sec = data.get("logging", {})
                if "level" in logging_sec:
                    level_str = str(logging_sec["level"]).upper()
                    if level_str in ("DEBUG", "INFO", "WARNING", "ERROR"):
                        cfg.log_level = level_str

            except Exception as e:
                logging.warning(
                    f"Failed to parse config at {cfg.config_path} ({e}), using defaults."
                )

        return cfg

    def save_default(self) -> None:
        """Create default config file if it does not already exist."""
        if not self.config_path.exists():
            self.config_path.parent.mkdir(parents=True, exist_ok=True)
            self.config_path.write_text(DEFAULT_CONFIG_TOML, encoding="utf-8")


# =============================================================================
# 2. Name Sanitizer & Path Safety
# =============================================================================


def sanitize_device_name(name: str) -> str:
    """Sanitize device name to prevent directory traversal or unsafe shell characters."""
    if not name or not name.strip():
        return "Unknown_Device"

    # Replace invalid filesystem characters with underscore
    sanitized = re.sub(r"[^\w\.\-\s]", "_", name.strip())
    # Replace whitespace sequences with hyphen or underscore for clean CLI paths
    sanitized = re.sub(r"\s+", "_", sanitized)
    # Collapse multiple consecutive underscores
    sanitized = re.sub(r"_+", "_", sanitized)
    sanitized = sanitized.strip("._-")

    if not sanitized:
        return "Unknown_Device"

    # Truncate length if unreasonably long
    return sanitized[:64]


def managed_device_name(device: "DeviceInfo") -> str:
    suffix = hashlib.sha256(f"{device.backend}:{device.id}".encode()).hexdigest()[:10]
    return f"{sanitize_device_name(device.name)[:53]}_{suffix}"


def is_safe_subpath(target_path: Path, base_dir: Path) -> bool:
    """Ensure target_path resolves strictly within base_dir (prevent path traversal)."""
    try:
        resolved_target = target_path.resolve()
        resolved_base = base_dir.resolve()
        return (
            resolved_target == resolved_base
            or resolved_base in resolved_target.parents
        )
    except Exception:
        return False


# =============================================================================
# 3. D-Bus Integration (GSConnect & KDE Connect)
# =============================================================================


@dataclass
class DeviceInfo:
    id: str
    name: str
    backend: str  # "gsconnect" or "kdeconnect"
    is_reachable: bool = True
    is_mounted: bool = False
    mount_point: Optional[str] = None
    host: Optional[str] = None
    port: Optional[int] = None


class DBusHelper:
    """Interacts with GSConnect and KDE Connect via D-Bus."""

    def __init__(self) -> None:
        self.bus: Optional[Gio.DBusConnection] = None
        if HAS_GI:
            try:
                self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            except Exception as e:
                logging.debug(f"Could not connect to session bus: {e}")

    def is_available(self) -> bool:
        return self.bus is not None

    def detect_backends(self) -> List[str]:
        """Detect which mobile integration backends are running."""
        backends = []
        if not self.bus:
            return backends

        try:
            res = self.bus.call_sync(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "ListNames",
                None,
                GLib.VariantType("(as)"),
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
            names = res.unpack()[0]
            if "org.gnome.Shell.Extensions.GSConnect" in names:
                backends.append("gsconnect")
            if "org.kde.kdeconnect" in names:
                backends.append("kdeconnect")
        except Exception as e:
            logging.debug(f"Failed to list D-Bus names: {e}")

        return backends

    def get_kdeconnect_devices(self) -> List[DeviceInfo]:
        """Query KDE Connect daemon for paired devices."""
        devices = []
        if not self.bus:
            return devices

        try:
            res = self.bus.call_sync(
                "org.kde.kdeconnect",
                "/modules/kdeconnect",
                "org.kde.kdeconnect.daemon",
                "devices",
                None,
                GLib.VariantType("(as)"),
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
            device_ids = res.unpack()[0]
            for dev_id in device_ids:
                name = self._get_kde_device_name(dev_id) or dev_id
                is_reachable = self._is_kde_device_reachable(dev_id)
                is_mounted = self._is_kde_device_mounted(dev_id) if is_reachable else False
                host = self._get_kde_device_host(dev_id)
                devices.append(
                    DeviceInfo(
                        id=dev_id,
                        name=name,
                        backend="kdeconnect",
                        is_reachable=is_reachable,
                        is_mounted=is_mounted,
                        host=host,
                    )
                )
        except Exception as e:
            logging.debug(f"Error querying KDE Connect devices: {e}")

        return devices

    def _get_kde_device_name(self, dev_id: str) -> Optional[str]:
        if not self.bus:
            return None
        try:
            res = self.bus.call_sync(
                "org.kde.kdeconnect",
                f"/modules/kdeconnect/devices/{dev_id}",
                "org.freedesktop.DBus.Properties",
                "Get",
                GLib.Variant("(ss)", ("org.kde.kdeconnect.device", "name")),
                GLib.VariantType("(v)"),
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
            return str(res.unpack()[0])
        except Exception:
            return None

    def _is_kde_device_reachable(self, dev_id: str) -> bool:
        if not self.bus:
            return False
        try:
            res = self.bus.call_sync(
                "org.kde.kdeconnect",
                f"/modules/kdeconnect/devices/{dev_id}",
                "org.freedesktop.DBus.Properties",
                "Get",
                GLib.Variant("(ss)", ("org.kde.kdeconnect.device", "isReachable")),
                GLib.VariantType("(v)"),
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
            return bool(res.unpack()[0])
        except Exception:
            return False

    def _get_kde_device_host(self, dev_id: str) -> Optional[str]:
        if not self.bus:
            return None
        try:
            res = self.bus.call_sync(
                "org.kde.kdeconnect",
                f"/modules/kdeconnect/devices/{dev_id}",
                "org.freedesktop.DBus.Properties",
                "Get",
                GLib.Variant("(ss)", ("org.kde.kdeconnect.device", "tcpHost")),
                GLib.VariantType("(v)"),
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
            return str(res.unpack()[0]) or None
        except Exception:
            return None

    def _is_kde_device_mounted(self, dev_id: str) -> bool:
        if not self.bus:
            return False
        try:
            res = self.bus.call_sync(
                "org.kde.kdeconnect",
                f"/modules/kdeconnect/devices/{dev_id}/sftp",
                "org.kde.kdeconnect.device.sftp",
                "isMounted",
                None,
                GLib.VariantType("(b)"),
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
            return bool(res.unpack()[0])
        except Exception:
            return False

    def mount_kde_device(self, dev_id: str) -> bool:
        """Trigger mount for KDE Connect device."""
        if not self.bus:
            return False
        try:
            logging.info(f"Triggering mount for KDE Connect device: {dev_id}")
            self.bus.call_sync(
                "org.kde.kdeconnect",
                f"/modules/kdeconnect/devices/{dev_id}/sftp",
                "org.kde.kdeconnect.device.sftp",
                "mountAndWait",
                None,
                None,
                Gio.DBusCallFlags.NONE,
                15000,
                None,
            )
            return True
        except Exception as e:
            logging.debug(f"mountAndWait failed, trying async mount: {e}")
            try:
                self.bus.call_sync(
                    "org.kde.kdeconnect",
                    f"/modules/kdeconnect/devices/{dev_id}/sftp",
                    "org.kde.kdeconnect.device.sftp",
                    "mount",
                    None,
                    None,
                    Gio.DBusCallFlags.NONE,
                    5000,
                    None,
                )
                return True
            except Exception as e2:
                logging.error(f"Failed to mount KDE Connect device {dev_id}: {e2}")
                return False

    def unmount_kde_device(self, dev_id: str) -> bool:
        if not self.bus:
            return False
        try:
            self.bus.call_sync(
                "org.kde.kdeconnect",
                f"/modules/kdeconnect/devices/{dev_id}/sftp",
                "org.kde.kdeconnect.device.sftp",
                "unmount",
                None,
                None,
                Gio.DBusCallFlags.NONE,
                5000,
                None,
            )
            return True
        except Exception as e:
            logging.error(f"Failed to unmount KDE Connect device {dev_id}: {e}")
            return False

    def get_gsconnect_devices(self) -> List[DeviceInfo]:
        """Query GSConnect for paired devices."""
        devices = []
        if not self.bus:
            return devices

        active_sftp_targets = []
        if HAS_GI and Gio:
            try:
                for m in Gio.VolumeMonitor.get().get_mounts():
                    root = m.get_root()
                    if root and root.get_uri_scheme() == "sftp":
                        active_sftp_targets.append(root.get_uri().lower())
                        active_sftp_targets.append(m.get_name().lower())
            except Exception:
                pass

        try:
            res = self.bus.call_sync(
                "org.gnome.Shell.Extensions.GSConnect",
                "/org/gnome/Shell/Extensions/GSConnect",
                "org.freedesktop.DBus.ObjectManager",
                "GetManagedObjects",
                None,
                GLib.VariantType("(a{oa{sa{sv}}})"),
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
            objects = res.unpack()[0]
            for path, interfaces in objects.items():
                if "/Device/" in path and "org.gnome.Shell.Extensions.GSConnect.Device" in interfaces:
                    props = interfaces["org.gnome.Shell.Extensions.GSConnect.Device"]
                    dev_id = path.split("/Device/")[-1]
                    name = str(props.get("Name") or props.get("name") or dev_id)
                    is_paired = bool(props.get("Paired", props.get("paired", False)))
                    is_connected = bool(props.get("Connected", props.get("connected", False)))
                    tcp_host = str(props.get("TcpHost") or props.get("tcpHost") or "") or None

                    is_mounted = False
                    if is_connected:
                        for target in active_sftp_targets:
                            if (tcp_host and tcp_host.lower() in target) or (name.lower() in target):
                                is_mounted = True
                                break

                    if is_paired:
                        devices.append(
                            DeviceInfo(
                                id=dev_id,
                                name=name,
                                backend="gsconnect",
                                is_reachable=is_connected,
                                is_mounted=is_mounted,
                                host=tcp_host,
                            )
                        )
        except Exception as e:
            logging.debug(f"Error querying GSConnect devices: {e}")

        return devices

    def mount_gsconnect_device(self, dev_id: str) -> bool:
        """Trigger SFTP mount action on GSConnect device."""
        if not self.bus:
            return False
        try:
            logging.info(f"Triggering mount for GSConnect device: {dev_id}")
            self.bus.call_sync(
                "org.gnome.Shell.Extensions.GSConnect",
                f"/org/gnome/Shell/Extensions/GSConnect/Device/{dev_id}",
                "org.gtk.Actions",
                "Activate",
                GLib.Variant("(sava{sv})", ("mount", [], {})),
                None,
                Gio.DBusCallFlags.NONE,
                5000,
                None,
            )
            return True
        except Exception as e:
            logging.error(f"Failed to mount GSConnect device {dev_id}: {e}")
            return False

    def unmount_gsconnect_device(self, dev_id: str) -> bool:
        """Trigger SFTP unmount action on GSConnect device."""
        if not self.bus:
            return False
        try:
            logging.info(f"Triggering unmount for GSConnect device: {dev_id}")
            self.bus.call_sync(
                "org.gnome.Shell.Extensions.GSConnect",
                f"/org/gnome/Shell/Extensions/GSConnect/Device/{dev_id}",
                "org.gtk.Actions",
                "Activate",
                GLib.Variant("(sava{sv})", ("unmount", [], {})),
                None,
                Gio.DBusCallFlags.NONE,
                5000,
                None,
            )
            return True
        except Exception as e:
            logging.debug(f"Failed to unmount GSConnect device {dev_id}: {e}")
            return False

    def unmount_gio_sftp(self, host_or_ip: str) -> bool:
        """Unmount any active GVfs SFTP mount matching host or IP."""
        if not HAS_GI or not Gio or not host_or_ip:
            return False
        unmounted = False
        try:
            for m in Gio.VolumeMonitor.get().get_mounts():
                root = m.get_root()
                if root and root.get_uri_scheme() == "sftp":
                    if host_or_ip in root.get_uri() or host_or_ip in m.get_name():
                        m.unmount_with_operation(Gio.MountUnmountFlags.NONE, None, None, None)
                        unmounted = True
        except Exception as e:
            logging.debug(f"GIO unmount failed: {e}")
        return unmounted

    def get_all_devices(self) -> List[DeviceInfo]:
        """Return combined list of devices across available backends."""
        return self.get_kdeconnect_devices() + self.get_gsconnect_devices()

    def find_device_by_name_or_id(self, query: str) -> Optional[DeviceInfo]:
        """Match a device by raw name, sanitized name, or ID."""
        if not query or not query.strip():
            return None
        devices = self.get_all_devices()
        q_lower = query.lower().strip()
        for dev in devices:
            if (
                dev.id.lower() == q_lower
                or dev.name.lower() == q_lower
                or sanitize_device_name(dev.name).lower() == q_lower
            ):
                return dev
        for dev in devices:
            if (
                q_lower in dev.name.lower()
                or q_lower in dev.id.lower()
                or q_lower in sanitize_device_name(dev.name).lower()
            ):
                return dev
        return None


