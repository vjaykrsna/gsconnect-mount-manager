class CLI:
    """Command Line Interface for GMM management."""

    def __init__(self, config: Config) -> None:
        self.config = config
        self.dbus = DBusHelper()
        self.bookmarks = BookmarkManager(config.bookmark_file)

    def cmd_status(self) -> int:
        """Display current GMM status, mounts, and bookmarks."""
        print(colorize(f"GMM (GSConnect Mount Manager) v{__version__}", COLOR_BOLD))
        print("─" * 50)
        print(f"Base Directory : {self.config.mount_structure_dir}")
        print(f"Bookmark Mode  : {self.config.bookmark_mode}")
        print(f"Bookmarks File : {self.config.bookmark_file}")
        print(f"Config File    : {self.config.config_path}")

        # Check running daemon via systemctl
        daemon_active = False
        try:
            res = subprocess.run(
                ["systemctl", "--user", "is-active", "--quiet", "gmm.service"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            daemon_active = (res.returncode == 0)
        except Exception:
            pass

        status_str = colorize("● Active (running)", COLOR_GREEN) if daemon_active else colorize("○ Inactive (stopped)", COLOR_YELLOW)
        print(f"Daemon Service : {status_str}")
        print()

        # Active mounts in GVfs
        print(colorize("Active SFTP Mounts:", COLOR_BOLD))
        sftp_mounts_found = False
        if HAS_GI and Gio:
            vm = Gio.VolumeMonitor.get()
            for m in vm.get_mounts():
                root = m.get_root()
                if root and root.get_uri_scheme() == "sftp":
                    loc = m.get_default_location()
                    path = loc.get_path() if loc else "N/A"
                    print(f"  • {colorize(m.get_name(), COLOR_CYAN)}")
                    print(f"    URI  : {root.get_uri()}")
                    print(f"    Path : {path}")
                    sftp_mounts_found = True

        if not sftp_mounts_found:
            print("  (No active SFTP storage mounts detected)")
        print()

        # Existing device directories
        print(colorize("Managed Device Folders:", COLOR_BOLD))
        dirs_found = False
        if self.config.mount_structure_dir.exists():
            for item in sorted(self.config.mount_structure_dir.iterdir()):
                if item.is_dir():
                    links = [l.name for l in item.iterdir() if l.is_symlink()]
                    links_str = ", ".join(links) if links else "no symlinks"
                    print(f"  • {item.name}/ [{links_str}]")
                    dirs_found = True

        if not dirs_found:
            print(f"  (No device folders in {self.config.mount_structure_dir})")
        print()

        # Registered bookmarks
        print(colorize("Current GTK Bookmarks:", COLOR_BOLD))
        all_bm = self.bookmarks.get_bookmarks()
        mount_dir_str = self.config.mount_structure_dir.as_posix()
        mount_dir_name = self.config.mount_structure_dir.name
        gmm_bm = [
            b for b in all_bm
            if mount_dir_str in urllib.parse.unquote(b) or f"/{mount_dir_name}/" in b or "sftp://" in b
        ]
        if gmm_bm:
            for b in gmm_bm:
                print(f"  • {b}")
        else:
            print("  (No device bookmarks registered)")

        return 0

    def cmd_list(self) -> int:
        """List paired devices from GSConnect and KDE Connect."""
        print(colorize("Available Paired Devices:", COLOR_BOLD))
        print("─" * 50)
        backends = self.dbus.detect_backends()
        if not backends:
            print("No active GSConnect or KDE Connect D-Bus services found.")
            return 0

        devices = self.dbus.get_all_devices()
        if not devices:
            print("No paired devices found.")
            return 0

        for dev in devices:
            reach_str = colorize("Online", COLOR_GREEN) if dev.is_reachable else colorize("Offline", COLOR_YELLOW)
            mount_str = colorize("Mounted", COLOR_CYAN) if dev.is_mounted else "Unmounted"
            print(f"• {colorize(dev.name, COLOR_BOLD)} ({dev.backend})")
            print(f"  ID     : {dev.id}")
            print(f"  Status : {reach_str} | {mount_str}")

        return 0

    def _mount_device(self, dev: DeviceInfo) -> bool:
        print(f"Mounting {dev.name} ({dev.backend})...")
        if dev.backend == "kdeconnect":
            success = self.dbus.mount_kde_device(dev.id)
        elif dev.backend == "gsconnect":
            success = self.dbus.mount_gsconnect_device(dev.id)
        else:
            success = False

        if success:
            print(colorize(f"Successfully triggered mount for {dev.name}.", COLOR_GREEN))
            return True
        else:
            print(colorize(f"Failed to mount {dev.name}.", COLOR_RED))
            return False

    def cmd_mount(self, device_query: Optional[str] = None) -> int:
        """Trigger mount for a specific device, or all online devices if no argument passed."""
        if not device_query:
            devices = [d for d in self.dbus.get_all_devices() if d.is_reachable]
            if not devices:
                print("No online paired devices found to mount.")
                return 0

            print(colorize(f"Mounting all online devices ({len(devices)} found)...", COLOR_BOLD))
            all_ok = True
            for dev in devices:
                if not self._mount_device(dev):
                    all_ok = False
            return 0 if all_ok else 1

        dev = self.dbus.find_device_by_name_or_id(device_query)
        if not dev:
            print(colorize(f"Error: Device '{device_query}' not found.", COLOR_RED))
            return 1

        return 0 if self._mount_device(dev) else 1

    def _unmount_device(self, dev: DeviceInfo) -> bool:
        print(f"Unmounting {dev.name} ({dev.backend})...")
        if dev.backend == "kdeconnect":
            success = self.dbus.unmount_kde_device(dev.id)
        elif dev.backend == "gsconnect":
            success = self.dbus.unmount_gsconnect_device(dev.id)
        else:
            success = False
        if not success:
            logging.error("Failed to unmount %s; preserving its artifacts", dev.name)
            return False

        # Trigger cleanup
        sanitized = managed_device_name(dev)
        dev_dir = (self.config.mount_structure_dir / sanitized).absolute()
        self.bookmarks.remove_device_bookmarks(sanitized, local_uri=dev_dir.as_uri())
        if is_safe_subpath(dev_dir, self.config.mount_structure_dir) and dev_dir.exists():
            DeviceController.cleanup_managed_links(dev_dir)
            # Remove directory if empty
            try:
                if not any(dev_dir.iterdir()):
                    dev_dir.rmdir()
                    print(f"Removed local directory {dev_dir}")
                else:
                    print(f"Preserved user files in {dev_dir}")
            except OSError:
                pass

        print(colorize(f"Cleaned up {dev.name}.", COLOR_GREEN))
        return True

    def cmd_unmount(self, device_query: Optional[str] = None) -> int:
        """Unmount a specific device, or all devices if no argument passed."""
        if not device_query:
            devices = [d for d in self.dbus.get_all_devices() if d.is_mounted or d.is_reachable]
            if devices:
                print(colorize(f"Unmounting all devices ({len(devices)} found)...", COLOR_BOLD))
                all_ok = True
                for dev in devices:
                    if not self._unmount_device(dev):
                        all_ok = False
            else:
                all_ok = True
                print("No mounted devices detected via D-Bus.")

            # Full sweep cleanup
            self.cmd_clean()
            return 0 if all_ok else 1

        dev = self.dbus.find_device_by_name_or_id(device_query)
        if not dev:
            # Fallback: check if managed device folder exists locally
            sanitized = sanitize_device_name(device_query)
            dev_dir = (self.config.mount_structure_dir / sanitized).absolute()
            if is_safe_subpath(dev_dir, self.config.mount_structure_dir) and dev_dir.exists() and not dev_dir.is_symlink():
                print(colorize(f"Device '{device_query}' not active on D-Bus, cleaning local directory...", COLOR_YELLOW))
                DeviceController.cleanup_managed_links(dev_dir)
                try:
                    if not any(dev_dir.iterdir()):
                        dev_dir.rmdir()
                        print(f"Removed local directory {dev_dir}")
                except OSError:
                    pass
                self.bookmarks.remove_device_bookmarks(sanitized, local_uri=dev_dir.as_uri())
                print(colorize(f"Cleaned up {sanitized}.", COLOR_GREEN))
                return 0

            print(colorize(f"Error: Device '{device_query}' not found.", COLOR_RED))
            return 1

        if not self._unmount_device(dev):
            return 1

        # Remove base directory if empty and not Home
        base_dir = self.config.mount_structure_dir.resolve()
        if base_dir != Path.home().resolve() and base_dir.exists():
            try:
                if not any(base_dir.iterdir()):
                    base_dir.rmdir()
                    logging.info(f"Removed empty base directory: {base_dir}")
            except OSError:
                pass

        return 0

    def cmd_clean(self) -> int:
        """Clean up stale symlinks, empty device folders, dangling bookmarks, and empty base folder."""
        print(colorize("Cleaning up GMM artifacts...", COLOR_BOLD))
        removed_links = 0
        removed_dirs = 0

        # Clean dead symlinks and empty directories
        if self.config.mount_structure_dir.exists():
            for dev_dir in list(self.config.mount_structure_dir.iterdir()):
                if dev_dir.is_dir() and not dev_dir.is_symlink():
                    removed_links += DeviceController.cleanup_managed_links(dev_dir, stale_only=True)

                    # Remove directory if empty
                    try:
                        if not any(dev_dir.iterdir()):
                            dev_dir.rmdir()
                            removed_dirs += 1
                            logging.info(f"Removed empty directory: {dev_dir}")
                    except OSError:
                        pass

            # Remove base directory if completely empty and not Home
            base_dir = self.config.mount_structure_dir.resolve()
            if base_dir != Path.home().resolve() and base_dir.exists():
                try:
                    if not any(base_dir.iterdir()):
                        base_dir.rmdir()
                        logging.info(f"Removed empty base directory: {base_dir}")
                except OSError:
                    pass

        # Clean bookmarks atomically with flock and URL decoding
        removed_bmarks = self.bookmarks.clean_bookmarks(self.config.mount_structure_dir)

        print(colorize(f"Clean complete. Removed {removed_links} dead symlinks, {removed_dirs} empty folders, {removed_bmarks} dead bookmarks.", COLOR_GREEN))
        return 0

    def cmd_doctor(self, export: bool = False) -> int:
        """Run system diagnostics for GMM prerequisites and output actionable tips."""
        lines = []

        def out(text: str, raw: str = ""):
            if export:
                lines.append(raw or re.sub(r"\033\[[0-9;]*m", "", text))
            else:
                print(text)

        out(colorize("GMM System Diagnostics (Doctor)", COLOR_BOLD), "# GMM System Diagnostics")
        out("─" * 50, "```text")

        # 1. Python & PyGObject
        py_ver = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
        out(f"Python Version     : {py_ver} " + colorize("✓", COLOR_GREEN), f"Python Version     : {py_ver} [OK]")

        if HAS_GI and Gio and GLib:
            out("PyGObject (gi)     : Available " + colorize("✓", COLOR_GREEN), "PyGObject (gi)     : Available [OK]")
        else:
            out("PyGObject (gi)     : " + colorize("MISSING (Install python3-gi)", COLOR_RED), "PyGObject (gi)     : MISSING")

        if tomllib:
            out("TOML Parser        : Available " + colorize("✓", COLOR_GREEN), "TOML Parser        : Available [OK]")
        else:
            out("TOML Parser        : " + colorize("MISSING (Python 3.11+ required)", COLOR_RED), "TOML Parser        : MISSING")

        # 2. D-Bus Session
        if self.dbus.is_available():
            out("D-Bus Session Bus  : Connected " + colorize("✓", COLOR_GREEN), "D-Bus Session Bus  : Connected [OK]")
        else:
            out("D-Bus Session Bus  : " + colorize("UNAVAILABLE", COLOR_RED), "D-Bus Session Bus  : UNAVAILABLE")

        # 3. Backends
        backends = self.dbus.detect_backends()
        if backends:
            out(f"Detected Backends  : {', '.join(backends)} " + colorize("✓", COLOR_GREEN), f"Detected Backends  : {', '.join(backends)} [OK]")
        else:
            out("Detected Backends  : " + colorize("None active", COLOR_YELLOW), "Detected Backends  : None active")

        # 4. Systemd
        has_systemctl = shutil.which("systemctl") is not None
        if has_systemctl:
            out("systemd            : Available " + colorize("✓", COLOR_GREEN), "systemd            : Available [OK]")
        else:
            out("systemd            : " + colorize("MISSING", COLOR_YELLOW), "systemd            : MISSING")

        # 5. GTK Bookmarks
        bm_exists = self.config.bookmark_file.exists()
        if bm_exists:
            out(f"GTK Bookmarks File : {self.config.bookmark_file} " + colorize("✓", COLOR_GREEN), f"GTK Bookmarks File : {self.config.bookmark_file} [OK]")
        else:
            out(f"GTK Bookmarks File : {self.config.bookmark_file} " + colorize("(Will be created)", COLOR_YELLOW), f"GTK Bookmarks File : {self.config.bookmark_file} [Pending]")

        out("─" * 50, "```")

        # Actionable Tips & Suggestions
        tips = []
        if not backends:
            tips.append("• No mobile backend detected. Ensure GSConnect (GNOME Extension) or KDE Connect is installed and running.")
            tips.append("• GSConnect and KDE Connect require local firewall ports 1716-1764 (TCP/UDP) open.")
        else:
            devices = self.dbus.get_all_devices()
            if not devices:
                tips.append("• Backend is active, but no paired devices were found. Pair your phone via GSConnect or KDE Connect settings.")
            else:
                unmounted = [d for d in devices if not d.is_mounted and d.is_reachable]
                if unmounted:
                    dev_names = ", ".join(d.name for d in unmounted)
                    tips.append(f"• Device(s) connected but storage unmounted: {dev_names}")
                    tips.append("  💡 Open KDE Connect on phone -> Plugin Settings -> enable 'Filesystem access' / Storage permissions.")

        if tips:
            if export:
                out("\n### Actionable Tips\n")
                for tip in tips:
                    out(tip)
            else:
                print(colorize("\nTroubleshooting Tips:", COLOR_BOLD))
                for tip in tips:
                    print(colorize(tip, COLOR_YELLOW))

        if export:
            print("\n".join(lines))
            print("\n*(Diagnostic report ready for copying into GitHub bug reports)*")

        return 0

    def cmd_config(self, show_path: bool = False, init: bool = False) -> int:
        """Inspect or initialize GMM configuration."""
        if show_path:
            print(self.config.config_path)
            return 0

        if init:
            if self.config.config_path.exists():
                print(colorize(f"Config file already exists at {self.config.config_path}", COLOR_YELLOW))
            else:
                self.config.save_default()
                print(colorize(f"Created default configuration at {self.config.config_path}", COLOR_GREEN))
            return 0

        print(colorize(f"GMM Configuration ({self.config.config_path}):", COLOR_BOLD))
        print("─" * 50)
        print(f"mount_structure_dir = {self.config.mount_structure_dir}")
        print(f"bookmark_mode       = {self.config.bookmark_mode}")
        print(f"notifications       = {self.config.notifications}")
        print(f"auto_mount          = {self.config.auto_mount}")
        print(f"auto_cleanup        = {self.config.auto_cleanup}")
        print(f"auto_discover       = {self.config.auto_discover}")
        print(f"exclude_directories = {self.config.exclude_directories}")
        print(f"custom_paths        = {self.config.custom_paths}")
        print(f"logging.level       = {self.config.log_level}")
        print(f"bookmarks_file      = {self.config.bookmark_file}")
        return 0

    def cmd_update(self) -> int:
        """Run the official installer to update the executable and user service."""
        import urllib.request

        installer_url = "https://raw.githubusercontent.com/vjaykrsna/gsconnect-mount-manager/main/install.sh"
        print(colorize("Updating GMM using the official installer...", COLOR_BOLD), flush=True)
        try:
            request = urllib.request.Request(installer_url, headers={"User-Agent": f"GMM-Updater/{__version__}"})
            with urllib.request.urlopen(request, timeout=10) as response:
                installer = response.read()
            # A private directory ensures the installer downloads the release executable
            # instead of accidentally picking up a local file named gmm.
            with tempfile.TemporaryDirectory(prefix="gmm-update-") as tmp:
                script = Path(tmp) / "install.sh"
                script.write_bytes(installer)
                result = subprocess.run(["bash", str(script)], check=False)
                if result.returncode:
                    logging.error("GMM installer failed with exit code %s", result.returncode)
                    return result.returncode
            return 0
        except (OSError, ValueError) as e:
            logging.error("Failed to update GMM: %s", e)
            return 1

    def cmd_uninstall(self, purge: bool = False, confirm: bool = False) -> int:
        """Uninstall GMM, stop service, and clean up artifacts."""
        if not confirm:
            print("Are you sure you want to uninstall GMM? [y/N]: ", end="", flush=True)
            choice = sys.stdin.readline().strip().lower()
            if choice not in ("y", "yes"):
                print("Uninstallation cancelled.")
                return 0

        print(colorize("Uninstalling GMM...", COLOR_BOLD))

        # 1. Clean symlinks & bookmarks
        self.cmd_clean()

        # 2. Stop & disable systemd user service
        service_name = "gmm.service"
        try:
            subprocess.run(["systemctl", "--user", "stop", service_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "--user", "disable", service_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        # 3. Remove systemd user service file
        config_home = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
        service_file = config_home / "systemd" / "user" / service_name
        if service_file.exists():
            try:
                service_file.unlink()
                subprocess.run(["systemctl", "--user", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(f"Removed systemd unit: {service_file}")
            except Exception as e:
                logging.warning(f"Could not remove {service_file}: {e}")

        # 4. Remove config directory if purge requested
        if purge:
            config_dir = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")) / "gmm"
            if config_dir.exists():
                shutil.rmtree(config_dir)
                print(f"Purged configuration directory: {config_dir}")

        # 5. Remove executable binary if installed in ~/.local/bin/gmm or XDG_BIN_HOME
        bin_dir = Path(os.environ.get("XDG_BIN_HOME") or (Path.home() / ".local" / "bin"))
        bin_path = bin_dir / "gmm"
        if bin_path.exists():
            try:
                bin_path.unlink()
                print(f"Removed executable: {bin_path}")
            except Exception as e:
                logging.warning(f"Could not remove {bin_path}: {e}")

        print(colorize("GMM has been successfully uninstalled.", COLOR_GREEN))
        return 0


